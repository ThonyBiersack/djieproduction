---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
projects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const skillDomains = [
  {
    domain: "Backend Engineering",
    description: "Server architecture, API design, and asynchronous runtimes.",
    skills: ["Node.js", "Express.js", "Hapi.js", "RESTful Contracts", "Input Validation (Joi)", "CRUD Workflows"]
  },
  {
    domain: "Data & Storage",
    description: "Database schemas, relation modeling, and local persistence.",
    skills: ["MongoDB", "Mongoose ODM", "SQLite", "Data Normalization", "Indexing Strategies", "Local Offline Sync"]
  },
  {
    domain: "Security & Auth",
    description: "Application-level security and authentication pipelines.",
    skills: ["JWT Authentication", "RBAC Middleware", "Bcrypt Hashing", "Bearer Tokens", "Session Hardening"]
  },
  {
    domain: "Client & UI Platforms",
    description: "Clean component models, static islands, and mobile interfaces.",
    skills: ["Astro", "Tailwind CSS", "TypeScript", "JavaScript (ES6+)", "Flutter & Dart", "Responsive Design"]
  },
  {
    domain: "Workflow & Tooling",
    description: "Developer ergonomics, version control, and cloud platforms.",
    skills: ["Git & GitHub", "Render PaaS", "Postman", "Vite", "VS Code", "Terminal Workflows"]
  }
];

const currentYear = new Date().getFullYear();
---

<Layout
  title="Anthony Suryadjie — Full-Stack Software Engineer"
  description="Full-Stack Software Engineer delivering end-to-end web applications with resilient backends, clean APIs, and responsive interfaces."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 min-h-screen">
      
      <!-- ==========================================
           LEFT PANE: FIXED EXECUTIVE DOSSIER
           ========================================== -->
      <aside class="lg:col-span-5 lg:sticky lg:top-0 lg:h-screen lg:py-16 py-12 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-zinc-800/60 lg:pr-10">
        <div>
          <!-- Availability Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-800 bg-zinc-900/90 text-zinc-300 text-xs font-mono mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Available for Full-Time Roles</span>
          </div>

          <!-- Identity -->
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-100">
            Anthony Suryadjie
          </h1>
          <p class="text-zinc-400 font-medium text-sm mt-1.5 tracking-tight">
            Full-Stack Software Engineer · End-to-End Web Systems
          </p>

          <p class="text-zinc-400 text-sm leading-relaxed mt-4 max-w-sm">
            I engineer end-to-end web systems—combining resilient backend services and database architectures with fast, responsive client interfaces.
          </p>

          <!-- 1-Click Direct Contact Bar -->
          <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-mono">
            <button
              id="copy-email-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-zinc-800/80 hover:bg-zinc-700/80 border border-zinc-700/60 text-zinc-200 transition-all focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:outline-none"
              title="Click to copy email address"
            >
              <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span id="copy-email-label">thony.djie@djieproduction.com</span>
            </button>

            <a
              href="https://github.com/ThonyBiersack"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-lg bg-zinc-800/80 hover:bg-zinc-700/80 border border-zinc-700/60 text-zinc-300 hover:text-white transition-colors"
              aria-label="GitHub profile"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
              </svg>
            </a>

            <a
              href="https://linkedin.com/in/anthony-suryadjie-500063200"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-lg bg-zinc-800/80 hover:bg-zinc-700/80 border border-zinc-700/60 text-zinc-300 hover:text-white transition-colors"
              aria-label="LinkedIn profile"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Footer Note -->
        <div class="hidden lg:block pt-6 text-[11px] font-mono text-zinc-500">
          Anthony Suryadjie &copy; {currentYear}. Built with Astro &amp; Tailwind CSS.
        </div>
      </aside>

      <!-- ==========================================
           RIGHT PANE: CONTINUOUS WORKSTREAM
           ========================================== -->
      <main id="main-content" class="lg:col-span-7 lg:py-16 py-8 space-y-20">
        
        <!-- Recruiter View Mode Switcher -->
        <div class="flex items-center justify-between p-3 rounded-xl border border-zinc-800 bg-zinc-900/30 backdrop-blur-sm">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono text-zinc-400">Recruiter Mode:</span>
          </div>
          <div class="flex items-center gap-1.5 bg-zinc-950/70 p-1 rounded-lg border border-zinc-800/80 text-xs font-mono">
            <button
              id="mode-quick"
              type="button"
              class="px-2.5 py-1 rounded bg-zinc-800 text-zinc-100 font-medium transition-all"
            >
              ⚡ Quick Scan
            </button>
            <button
              id="mode-deep"
              type="button"
              class="px-2.5 py-1 rounded text-zinc-400 hover:text-zinc-200 transition-all"
            >
              🔬 Deep Dive
            </button>
          </div>
        </div>

        <!-- SECTION 1: FEATURED SYSTEMS & APIS -->
        <section id="projects" class="space-y-6">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-zinc-400 mb-1 font-medium">01 // Case Studies</p>
            <h2 class="text-2xl font-bold tracking-tight text-zinc-100">Featured Systems &amp; APIs</h2>
            <p class="text-zinc-400 text-sm mt-1">
              Production architectures, stateless REST endpoints, and embedded data persistence.
            </p>
          </div>

          <div class="space-y-6">
            {projects.map((project) => (
              <article class="scroll-reveal rounded-xl border border-zinc-800/80 bg-zinc-900/40 hover:bg-zinc-900/70 hover:border-zinc-700 transition-all duration-200 p-6 flex flex-col justify-between group">
                <div>
                  <!-- Header tags -->
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono border border-emerald-500/20 bg-emerald-500/10 text-emerald-400">
                      <span class="w-1 h-1 rounded-full bg-emerald-400"></span>
                      {project.data.status}
                    </span>
                    <span class="px-2 py-0.5 rounded text-[11px] font-mono border border-zinc-700/60 bg-zinc-800/50 text-zinc-300">
                      {project.data.badge}
                    </span>
                  </div>

                  <!-- Title -->
                  <h3 class="text-lg font-semibold text-zinc-100 group-hover:text-white transition-colors tracking-tight">
                    {project.data.title}
                  </h3>

                  <!-- Summary -->
                  <p class="text-zinc-400 text-sm leading-relaxed mt-2">
                    {project.data.description}
                  </p>

                  <!-- Architectural Deep Dive details (Shown in Deep Dive Mode) -->
                  <div class="deep-dive-panel hidden mt-4 p-3 rounded-lg border border-zinc-800 bg-zinc-950/60 text-xs font-mono text-zinc-400 space-y-1.5">
                    <div class="text-zinc-300 font-semibold text-[11px] uppercase tracking-wider">Architecture Highlights:</div>
                    <ul class="list-disc list-inside space-y-1 text-zinc-400">
                      <li>Strict validation and sanitized inputs prior to data layer execution.</li>
                      <li>Stateless JWT authorization headers and granular access roles.</li>
                      <li>Optimized data constraints and relational indexing.</li>
                    </ul>
                  </div>

                  <!-- Tech Badges -->
                  <div class="flex flex-wrap gap-1.5 mt-5">
                    {project.data.tech.map((t) => (
                      <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800/70 border border-zinc-700/50 text-zinc-300">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Links -->
                <div class="pt-4 border-t border-zinc-800/60 mt-5 flex items-center gap-5 text-xs font-medium">
                  {project.data.demoUrl && (
                    <a
                      href={project.data.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-zinc-200 hover:text-white group/link"
                    >
                      <span>Live Demo</span>
                      <svg class="w-3.5 h-3.5 text-zinc-400 group-hover/link:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a
                      href={project.data.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-zinc-400 hover:text-zinc-200 group/link"
                    >
                      <span>Source Code</span>
                      <svg class="w-3.5 h-3.5 text-zinc-500 group-hover/link:text-zinc-300 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                      </svg>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- SECTION 2: TECHNICAL COMPETENCIES -->
        <section id="skills" class="space-y-6 pt-10 border-t border-zinc-800/60">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-zinc-400 mb-1 font-medium">02 // Capabilities</p>
            <h2 class="text-2xl font-bold tracking-tight text-zinc-100">Technical Arsenal</h2>
            <p class="text-zinc-400 text-sm mt-1">
              Languages, runtimes, and architectural patterns applied in production.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {skillDomains.map((s) => (
              <div class="scroll-reveal rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-5 flex flex-col justify-between hover:border-zinc-700 transition-colors">
                <div>
                  <h3 class="text-sm font-semibold text-zinc-100 tracking-tight">
                    {s.domain}
                  </h3>
                  <p class="text-xs text-zinc-400 mt-1 mb-4 leading-relaxed">
                    {s.description}
                  </p>
                  <div class="flex flex-wrap gap-1.5">
                    {s.skills.map((skill) => (
                      <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800/50 border border-zinc-700/40 text-zinc-300">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 3: BACKGROUND & ENGINEERING PHILOSOPHY -->
        <section id="about" class="space-y-6 pt-10 border-t border-zinc-800/60">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-zinc-400 mb-1 font-medium">03 // Principles</p>
            <h2 class="text-2xl font-bold tracking-tight text-zinc-100">Background &amp; Approach</h2>
          </div>

          <div class="space-y-4 text-zinc-400 text-sm leading-relaxed">
            <p>
              I believe great software engineering is about eliminating unnecessary complexity. Instead of chasing bloated microservices or unneeded abstraction layers, I focus on building rock-solid, cohesive systems that solve real problems.
            </p>
            <p>
              My background centers on backend integrity: strict schema constraints, verified token lifecycles, and resilient data storage. When building client interfaces with Astro or Flutter, I prioritize zero-overhead, responsive layouts that load instantaneously.
            </p>
            <p>
              I take pride in owning solutions end-to-end—designing database migrations, structuring route handlers, writing automated tests, and deploying production code.
            </p>
          </div>

          <div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 text-xs font-mono space-y-3">
            <div class="text-zinc-300 font-semibold pb-2 border-b border-zinc-800 uppercase tracking-wider text-[11px]">
              Profile At A Glance
            </div>
            <div class="grid grid-cols-2 gap-3 text-zinc-400">
              <div><span class="text-zinc-500">Location:</span> Indonesia (UTC+7)</div>
              <div><span class="text-zinc-500">Status:</span> Open to offers</div>
              <div><span class="text-zinc-500">Primary Core:</span> Node.js / TypeScript</div>
              <div><span class="text-zinc-500">Databases:</span> MongoDB / SQLite</div>
            </div>
          </div>
        </section>

        <!-- SECTION 4: DIRECT CONTACT -->
        <section id="contact" class="pt-10 border-t border-zinc-800/60 pb-16">
          <div class="rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-8 text-center space-y-4">
            <h2 class="text-xl font-bold tracking-tight text-zinc-100">
              Interested in working together?
            </h2>
            <p class="text-zinc-400 text-sm max-w-md mx-auto leading-relaxed">
              Whether you have an opening for an engineering role or need an end-to-end product built, my inbox is open.
            </p>
            <div class="pt-2">
              <a
                href="mailto:thony.djie@djieproduction.com"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-zinc-100 hover:bg-white text-zinc-950 font-medium text-xs tracking-tight transition-all shadow-sm focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:outline-none"
              >
                <span>Send Direct Email</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            </div>
          </div>
        </section>

      </main>
    </div>
  </div>

  <!-- Client Interactivity Script -->
  <script>
    // 1. Copy Email Button Handler
    const copyBtn = document.getElementById('copy-email-btn');
    const copyLabel = document.getElementById('copy-email-label');

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('thony.djie@djieproduction.com');
        if (copyLabel) {
          const original = copyLabel.textContent;
          copyLabel.textContent = 'Copied to clipboard!';
          copyBtn.classList.add('border-emerald-500/80', 'text-emerald-400');
          setTimeout(() => {
            copyLabel.textContent = original;
            copyBtn.classList.remove('border-emerald-500/80', 'text-emerald-400');
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });

    // 2. Recruiter View Mode Switcher
    const modeQuick = document.getElementById('mode-quick');
    const modeDeep = document.getElementById('mode-deep');
    const deepPanels = document.querySelectorAll('.deep-dive-panel');

    modeQuick?.addEventListener('click', () => {
      modeQuick.classList.add('bg-zinc-800', 'text-zinc-100');
      modeQuick.classList.remove('text-zinc-400');
      modeDeep?.classList.remove('bg-zinc-800', 'text-zinc-100');
      modeDeep?.classList.add('text-zinc-400');

      deepPanels.forEach(panel => panel.classList.add('hidden'));
    });

    modeDeep?.addEventListener('click', () => {
      modeDeep.classList.add('bg-zinc-800', 'text-zinc-100');
      modeDeep.classList.remove('text-zinc-400');
      modeQuick?.classList.remove('bg-zinc-800', 'text-zinc-100');
      modeQuick?.classList.add('text-zinc-400');

      deepPanels.forEach(panel => panel.classList.remove('hidden'));
    });
  </script>
</Layout>
