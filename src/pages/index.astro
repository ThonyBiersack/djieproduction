---

<Layout
  title="Djie Production — Full-Stack Web, Mobile & System Engineering by Anthony Djie"
  description="Djie Production is an independent full-stack software studio founded by Anthony Djie. Delivering complete web platforms, mobile Flutter apps, and scalable system architectures."
>
  <!-- ========================================================
       TOP FLOATING CAPSULE NAVBAR
       ======================================================== -->
  <header class="fixed top-4 left-0 right-0 z-50 flex justify-center px-4 pointer-events-none">
    <div class="pointer-events-auto flex items-center justify-between gap-6 sm:gap-10 px-4 sm:px-6 py-2.5 rounded-full bg-[#0d1017]/80 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/50 transition-all">
      
      <!-- Studio Icon "D" Only -->
      <a href="#hero" class="flex items-center group shrink-0" aria-label="Djie Production Home">
        <img
          src="/djie-icon-white.svg"
          alt="Djie Production"
          class="h-7 w-7 object-contain group-hover:scale-105 transition-transform"
          width="28"
          height="28"
        />
      </a>

      <!-- Navigation Links in English -->
      <nav class="flex items-center gap-4 sm:gap-7 text-xs font-mono text-text-muted" aria-label="Main Navigation">
        <a href="#about" class="hover:text-white transition-colors">About</a>
        <a href="#services" class="hover:text-white transition-colors">Services</a>
        <a href="#why-me" class="hover:text-white transition-colors">Why Me</a>
        <a href="#workflow" class="hover:text-white transition-colors">Workflow</a>
        <a href="#contact" class="hover:text-white transition-colors">Contact</a>
      </nav>

    </div>
  </header>

  <main id="main-content" class="pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-28">
      
      <!-- ========================================================
           SECTION 1: HERO - TIER-1 ENGINEERING PLATFORM
           ======================================================== -->
      <section id="hero" class="pt-12 md:pt-20 pb-4 space-y-12">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          
          <!-- Left Column: High-Impact Typography & Positioning -->
          <div class="lg:col-span-7 space-y-7 text-left">
            <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-sky-500/30 bg-sky-950/40 text-sky-300 text-xs font-mono shadow-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Available for High-Impact Product Engineering</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.08] text-white">
              Engineering Resilient <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-blue-400 to-indigo-300">Full-Stack Web</span> &amp; Digital Platforms.
            </h1>

            <p class="text-text-muted text-base sm:text-lg leading-relaxed max-w-xl">
              <strong class="text-white font-medium">Djie Production</strong> is an independent software engineering studio founded by <span class="text-sky-300 font-medium">Anthony Djie</span>. I architect and deliver complete web platforms, cross-platform Flutter clients, and high-performance cloud APIs for founders and businesses — zero middlemen, zero agency bloat.
            </p>

            <div class="flex flex-wrap items-center gap-3.5 pt-1 text-sm font-mono">
              <a
                href="#services"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold transition-all shadow-xl shadow-sky-500/20 active:scale-95"
              >
                <span>Explore Handled Systems</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>

              <a
                href="https://wa.me/6283845641526?text=Hi%20Anthony,%20I%20would%20like%20to%20discuss%20a%20software%20project%20with%20Djie%20Production."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-emerald-500/30 bg-emerald-950/30 hover:bg-emerald-900/40 text-emerald-300 transition-all text-xs font-semibold"
              >
                <span>Schedule Consultation</span>
                &rarr;
              </a>
            </div>
          </div>

          <!-- Right Column: Interactive System Architecture Console -->
          <div class="lg:col-span-5">
            <div class="terminal-window p-5 space-y-4">
              <!-- Window Bar -->
              <div class="flex items-center justify-between pb-3 border-b border-white/[0.08] text-xs font-mono">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-2 text-text-dim text-[11px]">djie-core-runtime.sys</span>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  All Nodes Operational
                </span>
              </div>

              <!-- Live Architecture Nodes -->
              <div class="space-y-3 font-mono text-xs">
                
                <!-- Node 1: Client Layer -->
                <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between">
                  <div class="space-y-0.5">
                    <div class="text-[10px] uppercase tracking-wider text-text-dim">Layer 01 &bull; Presentation</div>
                    <div class="text-white font-semibold flex items-center gap-2">
                      <span>Astro Islands + Flutter App</span>
                    </div>
                  </div>
                  <span class="text-[11px] text-sky-400 bg-sky-950/60 px-2 py-0.5 rounded border border-sky-500/30">Zero JS Bloat</span>
                </div>

                <!-- Pipeline Indicator -->
                <div class="flex items-center justify-center text-text-dim text-[10px] -my-1">
                  <span>&darr; HTTPS / gRPC Gateway (Strict Joi Sanitization)</span>
                </div>

                <!-- Node 2: Service & Auth Layer -->
                <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between">
                  <div class="space-y-0.5">
                    <div class="text-[10px] uppercase tracking-wider text-text-dim">Layer 02 &bull; API &amp; Security</div>
                    <div class="text-white font-semibold flex items-center gap-2">
                      <span>Node.js / Express &amp; Hapi Services</span>
                    </div>
                  </div>
                  <span class="text-[11px] text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-500/30">JWT &bull; RBAC</span>
                </div>

                <!-- Pipeline Indicator -->
                <div class="flex items-center justify-center text-text-dim text-[10px] -my-1">
                  <span>&darr; Low-Latency Queries &bull; ACID Transactions</span>
                </div>

                <!-- Node 3: Persistence Layer -->
                <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between">
                  <div class="space-y-0.5">
                    <div class="text-[10px] uppercase tracking-wider text-text-dim">Layer 03 &bull; Persistence</div>
                    <div class="text-white font-semibold flex items-center gap-2">
                      <span>MongoDB / SQLite (WAL Enabled)</span>
                    </div>
                  </div>
                  <span class="text-[11px] text-indigo-300 bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-500/30">Auto-Indexed</span>
                </div>

              </div>

              <!-- Console Status Footer -->
              <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between text-[11px] font-mono text-text-dim">
                <span>Direct Principal Architecture</span>
                <span class="text-sky-300">100% Owned Stack</span>
              </div>
            </div>
          </div>

        </div>

        <!-- ========================================================
             ENTERPRISE PROOF & METRICS SLA STRIP
             ======================================================== -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-5 rounded-2xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-md font-mono text-xs">
          <div class="space-y-1 p-2">
            <div class="text-2xl font-black text-white">&lt; 40ms</div>
            <div class="text-sky-300 font-semibold text-[11px]">Global Edge Routing</div>
            <div class="text-text-dim text-[10px]">Cloudflare distributed caching</div>
          </div>
          <div class="space-y-1 p-2">
            <div class="text-2xl font-black text-white">99.98%</div>
            <div class="text-emerald-300 font-semibold text-[11px]">High-Availability Design</div>
            <div class="text-text-dim text-[10px]">Zero-downtime PaaS deployment</div>
          </div>
          <div class="space-y-1 p-2">
            <div class="text-2xl font-black text-white">100%</div>
            <div class="text-white font-semibold text-[11px]">Principal Accountability</div>
            <div class="text-text-dim text-[10px]">Zero junior delegate handoffs</div>
          </div>
          <div class="space-y-1 p-2">
            <div class="text-2xl font-black text-white">Type-Safe</div>
            <div class="text-indigo-300 font-semibold text-[11px]">End-to-End Contracts</div>
            <div class="text-text-dim text-[10px]">Strict schema sanitization</div>
          </div>
        </div>

      </section>

      <!-- ========================================================
           SECTION 2: ABOUT (SOLOPRENEUR MODEL)
           ======================================================== -->
      <section id="about" class="scroll-reveal space-y-10 pt-10 border-t border-white/[0.07]">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          
          <!-- Narrative -->
          <div class="lg:col-span-7 space-y-5">
            <p class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold">About Studio</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
              Why Djie Production Operates as an Independent Studio
            </h2>

            <div class="space-y-4 text-text-muted text-sm sm:text-base leading-relaxed">
              <p>
                Many assume that larger agency headcounts guarantee superior software. In reality, large teams often introduce friction: client specifications pass through sales, account executives, and managers before reaching developers — often delegated down to junior hires.
              </p>
              <p>
                <strong class="text-white font-medium">Djie Production</strong> was founded by <span class="text-sky-300 font-medium">Anthony Djie</span> to eliminate this bureaucracy. As a solo product engineer, I focus on clean technical execution: architecting reliable database schemas, writing solid server logic, implementing clean high-utility web interfaces, and deploying cross-platform mobile applications.
              </p>
              <p>
                The outcome is cohesive, reliable software delivered with higher velocity, zero departmental finger-pointing, and clear cost efficiency.
              </p>
            </div>

            <!-- Key Advantages Pill -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs font-mono">
              <div class="p-4 rounded-xl bg-black/40 border border-white/[0.08]">
                <div class="text-white font-semibold mb-1">Direct Accountability</div>
                <div class="text-text-dim leading-relaxed">From the first line of code to production launch, you know exactly who is responsible.</div>
              </div>

              <div class="p-4 rounded-xl bg-black/40 border border-white/[0.08]">
                <div class="text-white font-semibold mb-1">Focused on Real Utility</div>
                <div class="text-text-dim leading-relaxed">No generic corporate slide decks — only robust software built for real operational use.</div>
              </div>
            </div>
          </div>

          <!-- Studio Dossier Card -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-white/10 bg-[#0d1017] p-7 space-y-6 shadow-xl">
              <div class="pb-4 border-b border-white/[0.08] flex items-center justify-between">
                <div>
                  <h3 class="text-base font-bold text-white">Studio Profile</h3>
                  <p class="text-xs font-mono text-text-dim">Djie Production</p>
                </div>
                <img src="/djie-icon-white.svg" alt="Djie Icon" class="w-8 h-8 opacity-80" />
              </div>

              <div class="space-y-3 font-mono text-xs">
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">Operating Model:</span>
                  <span class="text-white">Independent Studio (Solopreneur)</span>
                </div>
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">Founder &amp; Principal:</span>
                  <span class="text-sky-300 font-medium">Anthony Djie</span>
                </div>
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">Base Location:</span>
                  <span class="text-white">Indonesia (UTC+7)</span>
                </div>
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">Direct WhatsApp:</span>
                  <a href="https://wa.me/6283845641526" target="_blank" class="text-emerald-400 hover:underline">+62 838-4564-1526</a>
                </div>
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">Direct Email:</span>
                  <span class="text-sky-300">thony.djie@djieproduction.com</span>
                </div>
                <div class="flex justify-between pt-2">
                  <span class="text-text-dim">Availability:</span>
                  <span class="text-emerald-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    Open for New Projects
                  </span>
                </div>
              </div>

              <div class="pt-4 border-t border-white/[0.08]">
                <a
                  href="https://wa.me/6283845641526?text=Hi%20Anthony,%20I%20would%20like%20to%20discuss%20a%20software%20project%20with%20Djie%20Production."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 font-mono text-xs font-medium flex items-center justify-center gap-2 border border-emerald-500/30 transition-colors"
                >
                  <span>Chat via WhatsApp</span>
                  &rarr;
                </a>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ========================================================
           SECTION 3: SERVICES & HANDLED PROJECTS (BENTO GRID)
           ======================================================== -->
      <section id="services" class="scroll-reveal space-y-12 pt-10 border-t border-white/[0.07]">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold mb-2">Capabilities &amp; Proof of Work</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Core Services &amp; Handled Systems</h2>
            <p class="text-text-muted text-sm sm:text-base mt-2 max-w-2xl">
              Every service is backed by production-grade platforms architected, built, and shipped by Djie Production.
            </p>
          </div>
          <div class="hidden md:flex items-center gap-2 font-mono text-xs text-text-dim">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>4 Handled Systems Live</span>
          </div>
        </div>

        <div class="grid grid-cols-12 gap-6">
          {serviceProjects.map((item, idx) => {
            // Asymmetric Bento Grid Col Span
            const colSpan = (idx === 0 || idx === 3) 
              ? "col-span-12 lg:col-span-7" 
              : "col-span-12 lg:col-span-5";

            return (
              <article class={`${colSpan} bento-card p-7 sm:p-8 flex flex-col justify-between group transition-all duration-300`}>
                <div class="space-y-6">
                  
                  <!-- Service Category Header -->
                  <div class="border-b border-white/[0.08] pb-4">
                    <div class="flex items-center justify-between text-xs font-mono mb-2">
                      <span class="text-sky-400 font-semibold tracking-wider">CAPABILITY 0{idx + 1}</span>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 font-mono">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        {item.status}
                      </span>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-sky-300 transition-colors">
                      {item.serviceCategory}
                    </h3>
                    <p class="text-text-muted text-xs leading-relaxed mt-1">
                      {item.serviceSubtitle}
                    </p>
                  </div>

                  <!-- Associated Project Handled Details -->
                  <div class="space-y-4">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-mono text-text-dim uppercase tracking-wider">Handled Platform</span>
                      <span class="px-2.5 py-0.5 rounded text-[11px] font-mono bg-white/[0.04] border border-white/10 text-slate-300">
                        {item.projectBadge}
                      </span>
                    </div>

                    <h4 class="text-lg font-bold text-slate-100">
                      {item.projectTitle}
                    </h4>

                    <p class="text-xs text-text-muted leading-relaxed">
                      {item.description}
                    </p>

                    <!-- Highlights / What was architected -->
                    <div class="space-y-2.5 pt-1 rounded-xl bg-black/30 p-4 border border-white/[0.04]">
                      <div class="text-[11px] font-mono text-sky-300 uppercase tracking-wider">Engineered Architectural Highlights:</div>
                      <ul class="space-y-2 text-xs text-text-muted">
                        {item.highlights.map((point) => (
                          <li class="flex items-start gap-2">
                            <span class="text-sky-400 font-bold shrink-0 mt-0.5">&bull;</span>
                            <span class="leading-relaxed">{point}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- Tech Stack Pills -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {item.tech.map((t) => (
                        <span class="px-2.5 py-1 rounded text-xs font-mono bg-black/50 border border-white/[0.08] text-slate-300">
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>

                </div>

                <!-- Project Links / Verification -->
                <div class="pt-6 border-t border-white/[0.08] mt-6 flex items-center justify-between text-xs font-mono">
                  <div class="flex items-center gap-3">
                    {item.demoUrl && (
                      <a
                        href={item.demoUrl}
