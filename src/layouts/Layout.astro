---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Anthony Suryadjie — Full-Stack Software Engineer",
  description = "Full-Stack Software Engineer delivering end-to-end web applications with resilient backends, clean APIs, and responsive interfaces."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Anthony Suryadjie" />
    <link rel="icon" type="image/svg+xml" href="/djie-icon-white.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bg-dark text-text-main font-sans selection:bg-zinc-800 selection:text-white min-h-screen relative antialiased">
    <!-- Skip to main content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:font-mono focus:text-xs focus:rounded-md focus:outline-none focus:ring-2 focus:ring-zinc-400 font-medium"
    >
      Skip to main content
    </a>

    <!-- Top Scroll Progress Indicator -->
    <div
      id="scroll-progress-bar"
      class="fixed top-0 left-0 w-full h-[2px] bg-white/70 z-[60] pointer-events-none"
      role="progressbar"
      aria-label="Scroll progress"
    ></div>

    <!-- Refined Ambient Lighting -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-zinc-800/20 via-zinc-900/10 to-transparent blur-3xl opacity-60"></div>
    </div>
    
    <slot />

    <script>
      if (!CSS.supports('animation-timeline', 'scroll()')) {
        const bar = document.getElementById('scroll-progress-bar');
        if (bar) {
          const updateProgress = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const ratio = max > 0 ? window.scrollY / max : 0;
            bar.style.transform = `scaleX(${ratio})`;
          };
          window.addEventListener('scroll', updateProgress, { passive: true });
          updateProgress();
        }
      }
    </script>
  </body>
</html>
