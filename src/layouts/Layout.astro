---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const defaultTitle = "Djie Production — Full-Stack Web & Mobile Developer";
const defaultDescription = "Independent developer building web apps, Flutter mobile apps, and REST APIs. See my projects and request a quote.";

const {
  title = defaultTitle,
  description = defaultDescription,
  lang = "id"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = "https://djieproduction.com/og-image.png";
const locale = lang === 'id' ? 'id_ID' : 'en_US';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://djieproduction.com/#studio",
      "name": "Djie Production",
      "url": "https://djieproduction.com",
      "logo": "https://djieproduction.com/djie-icon-white.svg",
      "image": "https://djieproduction.com/og-image.png",
      "description": lang === 'id' 
        ? "Studio software independen spesialis jasa pembuatan website company profile, aplikasi kasir offline (POS), dan pengembangan sistem web custom untuk UMKM dan bisnis."
        : "Independent software studio specializing in company profile websites, offline cashier POS apps, and custom full-stack web platforms.",
      "telephone": "+6283845641526",
      "email": "thony.djie@djieproduction.com",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "ID"
      },
      "founder": {
        "@id": "https://djieproduction.com/#founder"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": lang === 'id' ? "Layanan Pengembangan Software" : "Software Engineering Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": lang === 'id' ? "Jasa Pembuatan Website Company Profile" : "Company Profile & Web Development"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": lang === 'id' ? "Aplikasi Kasir Offline (POS Flutter & SQLite)" : "Offline-First Cashier POS App"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": lang === 'id' ? "Pengembangan REST API & Arsitektur Backend" : "REST API & Backend Architecture"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": lang === 'id' ? "Website Undangan Digital Interaktif" : "Interactive Digital Invitation Web App"
            }
          }
        ]
      }
    },
    {
      "@type": "Person",
      "@id": "https://djieproduction.com/#founder",
      "name": "Anthony Djie",
      "jobTitle": "Full-Stack Developer & Founder",
      "url": "https://djieproduction.com",
      "sameAs": [
        "https://github.com/ThonyBiersack",
        "https://linkedin.com/in/anthony-suryadjie-500063200"
      ]
    }
  ]
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Anthony Djie — Djie Production" />
    <meta name="theme-color" content="#08090b" />
    <meta name="msvalidate.01" content="17FCB5B54F78BFE3B934EF16476523FD" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons & App Icons (Adaptive Light/Dark Mode) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/djie-icon-white.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/djie-icon-black.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Multi-Language Hreflang SEO -->
    <link rel="alternate" hreflang="id" href="https://djieproduction.com/" />
    <link rel="alternate" hreflang="en" href="https://djieproduction.com/en" />
    <link rel="alternate" hreflang="x-default" href="https://djieproduction.com/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Djie Production" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bg-dark text-text-main font-sans selection:bg-sky-500/20 selection:text-sky-200 min-h-screen relative antialiased overflow-x-hidden">
    <!-- Skip to main content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-sky-400 focus:text-black focus:font-mono focus:text-xs focus:rounded-md focus:outline-none focus:ring-2 focus:ring-sky-300 font-semibold"
    >
      Skip to content
    </a>

    <!-- Top Scroll Progress Indicator -->
    <div
      id="scroll-progress-bar"
      class="fixed top-0 left-0 w-full h-[2px] bg-gradient-to-r from-sky-400 via-blue-500 to-emerald-400 z-[60] pointer-events-none"
      role="progressbar"
      aria-label="Scroll progress"
    ></div>

    <!-- Interactive Cursor Spotlight -->
    <div id="cursor-spotlight" aria-hidden="true"></div>

    <!-- Engineering Blueprint Grid & Atmospheric Lighting -->
    <div class="fixed inset-0 pointer-events-none -z-10 bg-grid-pattern opacity-60"></div>
    <div class="fixed inset-0 pointer-events-none -z-10 bg-radial-vignette"></div>

    <slot />

    <script>
      // 1. Mouse Spotlight tracking
      const spotlight = document.getElementById('cursor-spotlight');
      if (spotlight && window.matchMedia('(pointer: fine)').matches) {
        let posX = window.innerWidth / 2;
        let posY = window.innerHeight / 3;
        let targetX = posX;
        let targetY = posY;

        window.addEventListener('mousemove', (e) => {
          targetX = e.clientX;
          targetY = e.clientY;
        });

        const loop = () => {
          posX += (targetX - posX) * 0.12;
          posY += (targetY - posY) * 0.12;
          spotlight.style.left = `${posX}px`;
          spotlight.style.top = `${posY}px`;
          requestAnimationFrame(loop);
        };
        loop();
      }

      // 2. High-Performance Universal Scroll Progress (Mobile & Desktop)
      const bar = document.getElementById('scroll-progress-bar');
      if (bar) {
        let ticking = false;
        const updateProgress = () => {
          const scrollH = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = scrollH > 0 ? Math.min(Math.max(window.scrollY / scrollH, 0), 1) : 0;
          bar.style.transform = `scaleX(${ratio})`;
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }, { passive: true });

        window.addEventListener('resize', updateProgress, { passive: true });
        updateProgress();
      }
    </script>
  </body>
</html>