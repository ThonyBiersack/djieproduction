---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Djie Production — Independent Full-Stack Web & Mobile Product Studio",
  description = "Independent full-stack software studio by Anthony Djie. Engineering end-to-end web applications, cross-platform Flutter apps, and scalable cloud architectures."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Anthony Djie — Djie Production" />
    <link rel="icon" type="image/svg+xml" href="/djie-icon-white.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-bg-dark text-text-main font-sans selection:bg-sky-500/20 selection:text-sky-200 min-h-screen relative antialiased overflow-x-hidden">
    <!-- Skip to main content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-sky-400 focus:text-black focus:font-mono focus:text-xs focus:rounded-md focus:outline-none focus:ring-2 focus:ring-sky-300 font-semibold"
    >
      Skip to content
    </a>

    <!-- Top Scroll Progress Indicator -->
    <div
      id="scroll-progress-bar"
      class="fixed top-0 left-0 w-full h-[2px] bg-gradient-to-r from-sky-400 via-blue-500 to-emerald-400 z-[60] pointer-events-none"
      role="progressbar"
      aria-label="Scroll progress"
    ></div>

    <!-- Interactive Cursor Spotlight -->
    <div id="cursor-spotlight" aria-hidden="true"></div>

    <!-- Engineering Blueprint Grid & Atmospheric Lighting -->
    <div class="fixed inset-0 pointer-events-none -z-10 bg-grid-pattern opacity-60"></div>
    <div class="fixed inset-0 pointer-events-none -z-10 bg-radial-vignette"></div>

    <slot />

    <script>
      // 1. Mouse Spotlight tracking
      const spotlight = document.getElementById('cursor-spotlight');
      if (spotlight && window.matchMedia('(pointer: fine)').matches) {
        let posX = window.innerWidth / 2;
        let posY = window.innerHeight / 3;
        let targetX = posX;
        let targetY = posY;

        window.addEventListener('mousemove', (e) => {
          targetX = e.clientX;
          targetY = e.clientY;
        });

        const loop = () => {
          posX += (targetX - posX) * 0.12;
          posY += (targetY - posY) * 0.12;
          spotlight.style.left = `${posX}px`;
          spotlight.style.top = `${posY}px`;
          requestAnimationFrame(loop);
        };
        loop();
      }

      // 2. Fallback Scroll Progress
      if (!CSS.supports('animation-timeline', 'scroll()')) {
        const bar = document.getElementById('scroll-progress-bar');
        if (bar) {
          const updateProgress = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const ratio = max > 0 ? window.scrollY / max : 0;
            bar.style.transform = `scaleX(${ratio})`;
          };
          window.addEventListener('scroll', updateProgress, { passive: true });
          updateProgress();
        }
      }
    </script>
  </body>
</html>