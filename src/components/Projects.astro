---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
projects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section id="projects" class="py-24 border-t border-zinc-800/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="mb-12">
      <p class="text-xs font-mono uppercase tracking-widest text-zinc-400 mb-2 font-medium">Our Work</p>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100">Handled Projects</h2>
      <p class="text-zinc-400 text-sm mt-2 max-w-xl">
        Production systems, REST API architectures, and offline databases built and delivered by Djie Production.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <article class="scroll-reveal rounded-xl border border-zinc-800/80 bg-zinc-900/40 hover:bg-zinc-900/80 hover:border-zinc-700 transition-all duration-200 flex flex-col justify-between group overflow-hidden">
          <div class="p-6">
            <!-- Metadata Tags -->
            <div class="flex items-center justify-between gap-2 mb-4">
              {project.data.status && (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono border border-emerald-500/20 bg-emerald-500/10 text-emerald-400">
                  <span class="w-1 h-1 rounded-full bg-emerald-400"></span>
                  {project.data.status}
                </span>
              )}
              {project.data.badge && (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono border border-zinc-700/60 bg-zinc-800/50 text-zinc-300">
                  {project.data.badge}
                </span>
              )}
            </div>

            <!-- Title & Description -->
            <h3 class="text-lg font-semibold text-zinc-100 group-hover:text-white transition-colors mb-2 tracking-tight">
              {project.data.title}
            </h3>
            <p class="text-zinc-400 text-sm leading-relaxed mb-6">
              {project.data.description}
            </p>

            <!-- Tech Badges -->
            <div class="flex flex-wrap gap-1.5">
              {project.data.tech.map((techItem) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800/70 border border-zinc-700/50 text-zinc-300">
                  {techItem}
                </span>
              ))}
            </div>
          </div>

          <!-- Action Links -->
          <div class="p-6 pt-0 border-t border-zinc-800/60 mt-4 flex items-center gap-4 text-xs font-medium">
            {project.data.demoUrl && (
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-zinc-200 hover:text-white py-2 group/link"
              >
                <span>Live Demo</span>
                <svg class="w-3.5 h-3.5 text-zinc-400 group-hover/link:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            )}
            {project.data.repoUrl && (
              <a
                href={project.data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-zinc-400 hover:text-zinc-200 py-2 group/link"
              >
                <span>Source Code</span>
                <svg class="w-3.5 h-3.5 text-zinc-500 group-hover/link:text-zinc-300 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
