---
export interface StageData {
  id: string;
  title: string;
  subtitle: string;
  detailTitle: string;
  detailDesc: string;
  ariaLabel: string;
  svgCat: string;
}

export type StageCopy = Omit<StageData, 'svgCat'> & {
  clientAction: string;
  deliverable: string;
};

export interface Props {
  stages?: StageCopy[];
  labels?: {
    flow: string;
    pause: string;
    resume: string;
    stage: string;
    clientAction: string;
    deliverable: string;
  };
}

const { stages: customStages, labels: customLabels } = Astro.props;

// Shared Base Cat (Light blue-white fur #e0f2fe, pink ears #f472b6, tabby stripes #94a3b8)
const BASE_CAT = `
  <ellipse cx="50" cy="85" rx="32" ry="18" fill="#e0f2fe" />
  <polygon points="26,22 18,2 38,14" fill="#e0f2fe" /><polygon points="27,19 21,6 35,14" fill="#f472b6" />
  <polygon points="74,22 82,2 62,14" fill="#e0f2fe" /><polygon points="73,19 79,6 65,14" fill="#f472b6" />
  <circle cx="50" cy="42" r="28" fill="#e0f2fe" />
  <path d="M46,18v8M50,16v10M54,18v8" stroke="#94a3b8" stroke-width="2.5" stroke-linecap="round" />
  <path d="M30,44L14,42M30,48L16,49M70,44L86,42M70,48L84,49" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" />
  <polygon points="50,45 47,42 53,42" fill="#f472b6" />
`;

const EYES = `
  <ellipse class="cat-eye-l" cx="38" cy="38" rx="3.5" ry="4.5" fill="#0f172a" /><ellipse class="cat-eye-r" cx="62" cy="38" rx="3.5" ry="4.5" fill="#0f172a" />
  <circle cx="36.5" cy="36.5" r="1.2" fill="#fff" /><circle cx="60.5" cy="36.5" r="1.2" fill="#fff" />
`;

const defaultStages: StageData[] = [
  {
    id: 'brief', title: 'Brief', subtitle: 'Idea and goals', detailTitle: 'Share your idea',
    detailDesc: 'We discuss your core concept, technical feasibility, and essential business goals.',
    ariaLabel: 'Brief: idea and goals',
    svgCat: `${BASE_CAT}${EYES}
      <ellipse class="cat-mouth-talking" cx="50" cy="50" rx="3" ry="2" fill="#e11d48" />
      <path d="M47,45Q50,48 53,45" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" />
      <rect x="29" y="31" width="18" height="14" rx="3" fill="none" stroke="#38bdf8" stroke-width="2" />
      <rect x="53" y="31" width="18" height="14" rx="3" fill="none" stroke="#38bdf8" stroke-width="2" />
      <line x1="47" y1="38" x2="53" y2="38" stroke="#38bdf8" stroke-width="2" />
      <g class="cat-speech-bubble" transform="translate(68,-4)">
        <rect width="28" height="18" rx="6" fill="#0a1a3d" stroke="#38bdf8" stroke-width="1.5" />
        <polygon points="4,18 0,23 9,18" fill="#0a1a3d" stroke="#38bdf8" stroke-width="1.5" />
        <circle class="cat-typing-dot d1" cx="8" cy="9" r="1.8" fill="#38bdf8" />
        <circle class="cat-typing-dot d2" cx="14" cy="9" r="1.8" fill="#38bdf8" />
        <circle class="cat-typing-dot d3" cx="20" cy="9" r="1.8" fill="#38bdf8" />
      </g>`
  },
  {
    id: 'discovery', title: 'Discovery', subtitle: 'Scope and journeys', detailTitle: 'Map the scope',
    detailDesc: 'We define concrete user journeys, core milestones, and technical boundaries.',
    ariaLabel: 'Discovery: scope and journeys',
    svgCat: `${BASE_CAT}
      <g class="cat-scanning-eyes">${EYES}</g>
      <path d="M44,47Q47,50 50,47Q53,50 56,47" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" />
      <g transform="translate(20,52)">
        <polygon points="4,28 30,22 56,28 56,4 30,0 4,4" fill="#0a1a3d" stroke="#38bdf8" stroke-width="1.8" />
        <line x1="30" y1="0" x2="30" y2="22" stroke="#38bdf8" stroke-width="1.5" />
        <line class="cat-book-line" x1="10" y1="8" x2="24" y2="7" stroke="#e0f2fe" stroke-width="1.5" />
        <line class="cat-book-line" x1="10" y1="13" x2="22" y2="12" stroke="#e0f2fe" stroke-width="1.5" />
        <line class="cat-book-line" x1="36" y1="7" x2="50" y2="8" stroke="#e0f2fe" stroke-width="1.5" />
        <line class="cat-book-line" x1="36" y1="12" x2="48" y2="13" stroke="#e0f2fe" stroke-width="1.5" />
      </g>
      <ellipse cx="26" cy="56" rx="5" ry="4" fill="#e0f2fe" stroke="#94a3b8" stroke-width="1" />
      <ellipse cx="74" cy="56" rx="5" ry="4" fill="#e0f2fe" stroke="#94a3b8" stroke-width="1" />`
  },
  {
    id: 'blueprint', title: 'Blueprint', subtitle: 'Schema and API', detailTitle: 'Design the system',
    detailDesc: 'We architect database schemas, REST API contracts, and security policies.',
    ariaLabel: 'Blueprint: schema and API',
    svgCat: `${BASE_CAT}${EYES}
      <path d="M44,47Q47,50 50,47Q53,50 56,47" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" />
      <g transform="translate(18,54)">
        <rect width="64" height="34" rx="4" fill="#1e3a8a" stroke="#60a5fa" stroke-width="1.5" />
        <path class="cat-blueprint-schema" d="M6,6H26V18H6ZM38,6H58V18H38ZM26,12H38M32,18V28H46" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" pathLength="100" />
      </g>
      <g class="cat-drawing-paw">
        <ellipse cx="66" cy="68" rx="6" ry="5" fill="#e0f2fe" stroke="#94a3b8" stroke-width="1" />
        <polygon points="69,67 79,48 76,46 66,65" fill="#f59e0b" /><polygon points="69,67 66,72 66,65" fill="#0f172a" />
      </g>`
  },
  {
    id: 'build', title: 'Build', subtitle: 'Backend and UI', detailTitle: 'Ship the product',
    detailDesc: 'We write validated endpoints, slice clean UI, and wire resilient state management.',
    ariaLabel: 'Build: backend and UI',
    svgCat: `${BASE_CAT}
      <path d="M34,31L44,35M66,31L56,35M35,38L42,38M58,38L65,38" stroke="#0f172a" stroke-width="2.2" stroke-linecap="round" />
      <path d="M45,49Q50,46 55,49" fill="none" stroke="#64748b" stroke-width="1.8" stroke-linecap="round" />
      <polygon points="22,76 78,76 84,94 16,94" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" />
      <polygon points="26,52 74,52 78,76 22,76" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5" />
      <circle cx="50" cy="64" r="3.5" fill="#38bdf8" />
      <rect class="cat-flying-key k1" x="24" y="44" width="4" height="4" rx="1" fill="#38bdf8" />
      <rect class="cat-flying-key k2" x="72" y="46" width="4" height="4" rx="1" fill="#5ee1ff" />
      <rect class="cat-flying-key k3" x="48" y="40" width="3.5" height="3.5" rx="1" fill="#e0f2fe" />
      <ellipse class="cat-paw-l" cx="30" cy="74" rx="5.5" ry="4" fill="#e0f2fe" stroke="#94a3b8" stroke-width="1" />
      <ellipse class="cat-paw-r" cx="70" cy="74" rx="5.5" ry="4" fill="#e0f2fe" stroke="#94a3b8" stroke-width="1" />`
  },
  {
    id: 'live', title: 'Live', subtitle: 'Edge deployment', detailTitle: 'Go live',
    detailDesc: 'We deploy to edge CDN networks, perform security checks, and celebrate production launch.',
    ariaLabel: 'Live: edge deployment',
    svgCat: `
      <g class="cat-happy-head">${BASE_CAT}
        <polygon points="50,-6 40,20 60,20" fill="#f59e0b" stroke="#fcd34d" stroke-width="1" />
        <circle cx="50" cy="-6" r="3" fill="#ec4899" />
        <path d="M34,38Q38,32 42,38M58,38Q62,32 66,38" fill="none" stroke="#0f172a" stroke-width="2.5" stroke-linecap="round" />
        <path d="M42,46Q50,56 58,46Z" fill="#e11d48" stroke="#64748b" stroke-width="1.5" />
      </g>
      <g class="cat-celebrate-paws">
        <ellipse cx="22" cy="40" rx="5.5" ry="7" fill="#e0f2fe" stroke="#94a3b8" stroke-width="1" transform="rotate(-25 22 40)" />
        <ellipse cx="78" cy="40" rx="5.5" ry="7" fill="#e0f2fe" stroke="#94a3b8" stroke-width="1" transform="rotate(25 78 40)" />
      </g>
      <g class="cat-confetti"><rect x="18" y="10" width="3" height="3" fill="#38bdf8" /><circle cx="82" cy="14" r="2" fill="#f43f5e" /><rect x="28" y="2" width="2" height="4" fill="#10b981" /><circle cx="70" cy="4" r="1.8" fill="#fbbf24" /></g>`
  }
];

const stages = defaultStages.map((stage, index) => {
  const copy = customStages?.[index];
  return copy ? { ...stage, ...copy } : { ...stage, clientAction: '', deliverable: '' };
});
const labels = {
  flow: 'Project workflow',
  pause: 'Pause animation',
  resume: 'Resume animation',
  stage: 'Stage',
  clientAction: 'Your part',
  deliverable: 'What you get',
  ...customLabels
};
---

<div class="stage" id="pipeline-cats-stage">
  <div class="blob blob-1"></div><div class="blob blob-2"></div>
  <div class="stage-header">
    <div class="stage-tag-badge">
      <span class="pulse-dot"></span>
      <span class="font-mono text-xs uppercase tracking-wider text-sky-300">{labels.flow}</span>
    </div>
    <button id="cat-flow-pause-btn" class="pause-toggle" type="button" aria-label={labels.pause}>
      <svg class="pause-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 5v14M16 5v14" /></svg>
      <svg class="resume-icon" aria-hidden="true" viewBox="0 0 24 24" hidden><path d="m8 5 11 7-11 7z" /></svg>
      <span class="pause-label font-mono text-xs">{labels.pause}</span>
    </button>
  </div>

  <div class="field" id="cat-flow-field">
    <canvas id="cat-flow-canvas" aria-hidden="true"></canvas>
    {stages.map((st, i) => (
      <div class="gate-wrap" data-index={i}>
        <button class={`gate ${i === 0 ? 'on' : ''}`} data-stage={st.id} data-index={i} aria-label={st.ariaLabel} type="button">
          <svg viewBox="0 -8 100 108" class="cat-svg" set:html={st.svgCat} />
        </button>
        <div class={`gate-label ${i === 0 ? 'on' : ''}`} aria-hidden="true">
          <div class="label-title">{st.title}</div><div class="label-sub">{st.subtitle}</div>
        </div>
      </div>
    ))}
  </div>

  <div class="detail" id="cat-flow-detail" aria-live="polite">
    <div class="detail-badge font-mono text-[11px] text-sky-400 font-semibold tracking-wider uppercase">{labels.stage} <span id="detail-step-num">01</span> / {String(stages.length).padStart(2, '0')}</div>
    <h3 class="detail-title text-xl sm:text-2xl font-bold text-white tracking-tight" id="detail-title">{stages[0].detailTitle}</h3>
    <p class="detail-desc text-text-muted text-sm sm:text-base max-w-2xl mx-auto" id="detail-desc">{stages[0].detailDesc}</p>
    <dl class="detail-outcomes">
      <div>
        <dt>{labels.clientAction}</dt>
        <dd id="detail-client-action">{stages[0].clientAction}</dd>
      </div>
      <div>
        <dt>{labels.deliverable}</dt>
        <dd id="detail-deliverable">{stages[0].deliverable}</dd>
      </div>
    </dl>
  </div>
</div>

<script is:inline define:vars={{ stagesData: stages, labelsData: labels }}>
(function () {
  const container = document.getElementById('pipeline-cats-stage');
  const field = document.getElementById('cat-flow-field');
  const canvas = document.getElementById('cat-flow-canvas');
  const pauseBtn = document.getElementById('cat-flow-pause-btn');
  const detailTitle = document.getElementById('detail-title'), detailDesc = document.getElementById('detail-desc'), detailStepNum = document.getElementById('detail-step-num');
  const detailClientAction = document.getElementById('detail-client-action'), detailDeliverable = document.getElementById('detail-deliverable');
  if (!container || !field || !canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const gates = Array.from(field.querySelectorAll('.gate'));
  const labels = Array.from(field.querySelectorAll('.gate-label'));
  let isPaused = window.matchMedia('(prefers-reduced-motion: reduce)').matches, animId = null, lastTime = performance.now();
  let width = field.clientWidth, height = field.clientHeight, isDesktop = width >= 700;
  let L = isDesktop ? width : height, A = isDesktop ? 44 : 34, pad = isDesktop ? 0.09 : 0.10, BASE = isDesktop ? 46 : 30;
  let pointer = { x: -9999, y: -9999, active: false };
  let gateCoords = [], shockwaves = [], sparks = [];

  function updateGatePositions() {
    width = field.clientWidth; height = field.clientHeight; isDesktop = width >= 700;
    L = isDesktop ? width : height; A = isDesktop ? 44 : 34; pad = isDesktop ? 0.09 : 0.10; BASE = isDesktop ? 46 : 30;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = width * dpr; canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    gateCoords = [];
    const wraps = field.querySelectorAll('.gate-wrap');
    for (let i = 0; i < stagesData.length; i++) {
      const t = L * (pad + (1 - 2 * pad) * (i / 4));
      const perp = A * Math.sin((t / L) * 2.5 * Math.PI - 0.6);
      const gx = isDesktop ? t : width * 0.35 + perp;
      const gy = isDesktop ? height * 0.5 + perp : t;
      gateCoords.push({ x: gx, y: gy, t: t / L });
      if (wraps[i]) { wraps[i].style.left = `${gx}px`; wraps[i].style.top = `${gy}px`; }
    }
  }

  function triggerGateShockwave(idx) {
    const c = gateCoords[idx]; if (!c) return;
    shockwaves.push({ x: c.x, y: c.y, r: 10, maxR: 70, alpha: 0.9 }, { x: c.x, y: c.y, r: 24, maxR: 90, alpha: 0.7 });
    for (let s = 0; s < (idx === stagesData.length - 1 ? 70 : 30); s++) {
      const angle = Math.random() * Math.PI * 2, spd = 40 + Math.random() * 110;
      sparks.push({ x: c.x, y: c.y, vx: Math.cos(angle) * spd, vy: Math.sin(angle) * spd, life: 1.0, color: Math.random() > 0.4 ? '#38bdf8' : '#5ee1ff' });
    }
  }

  const P_COUNT = Math.round(Math.min(1100, Math.max(450, L * 1.05))), colors = ['#2563eb', '#38bdf8', '#7dd3fc', '#e0f2fe'];
  const randG = () => (Math.random() + Math.random() + Math.random() - 1.5) / 1.5;
  const particles = Array.from({ length: P_COUNT }, () => ({
    u: Math.random(), off: randG(), speed: 0.08 + Math.random() * 0.07, size: 0.7 + Math.random() * 1.6,
    color: colors[Math.floor(Math.random() * colors.length)], dx: 0, dy: 0
  }));

  let wx = -0.08 * L, currentActive = 0;
  function setActiveStage(idx) {
    if (idx === currentActive && gates[idx].classList.contains('on')) return;
    currentActive = idx;
    gates.forEach((g, i) => {
      g.classList.toggle('on', i === idx); g.classList.toggle('done', i < idx);
      labels[i].classList.toggle('on', i === idx); labels[i].classList.toggle('done', i < idx);
    });
    triggerGateShockwave(idx);
    const st = stagesData[idx];
    if (st && detailTitle && detailDesc && detailStepNum && detailClientAction && detailDeliverable) {
      detailStepNum.textContent = `0${idx + 1}`; detailTitle.textContent = st.detailTitle; detailDesc.textContent = st.detailDesc;
      detailClientAction.textContent = st.clientAction; detailDeliverable.textContent = st.deliverable;
      const dEl = document.getElementById('cat-flow-detail');
      if (dEl) { dEl.classList.remove('fade-up'); void dEl.offsetWidth; dEl.classList.add('fade-up'); }
    }
  }

  function tick(now) {
    if (isPaused) return;
    const dt = Math.min((now - lastTime) / 1000, 0.05); lastTime = now;
    ctx.globalCompositeOperation = 'destination-out'; ctx.fillStyle = 'rgba(0,0,0,0.2)'; ctx.fillRect(0, 0, width, height);

    wx += (1.12 * L / 9.5) * dt; if (wx > 1.04 * L) wx = -0.08 * L;
    for (let i = 0; i < stagesData.length; i++) {
      const g = gateCoords[i];
      if (g && wx >= g.t * L && wx - (1.12 * L / 9.5 * dt) < g.t * L) setActiveStage(i);
    }

    ctx.globalCompositeOperation = 'lighter';
    for (let i = 0; i < stagesData.length; i++) {
      const g = gateCoords[i]; if (!g) continue;
      const it = i === currentActive ? 1.0 : (i < currentActive ? 0.35 : 0.12);
      const rad = ctx.createRadialGradient(g.x, g.y, 8, g.x, g.y, 64);
      rad.addColorStop(0, `rgba(56,189,248,${0.45 * it})`); rad.addColorStop(1, 'rgba(56,189,248,0)');
      ctx.fillStyle = rad; ctx.beginPath(); ctx.arc(g.x, g.y, 64, 0, Math.PI * 2); ctx.fill();
    }

    for (let i = 0; i < particles.length; i++) {
      const p = particles[i]; p.u += p.speed * dt; if (p.u > 1) { p.u = 0; p.off = randG(); }
      const t = p.u * L, cl = A * Math.sin(p.u * 2.5 * Math.PI - 0.6);
      let minDist = 9999;
      for (let g = 0; g < gateCoords.length; g++) { const d = Math.abs(t - gateCoords[g].t * L); if (d < minDist) minDist = d; }
      const pinch = 0.16 + 0.84 * (1 - Math.exp(-Math.pow(minDist / (0.05 * L), 2)));
      const spread = (BASE * pinch + Math.sin(p.u * 14 + now * 0.003) * 3) * p.off;
      let px = isDesktop ? t : width * 0.35 + cl + spread, py = isDesktop ? height * 0.5 + cl + spread : t;

      if (pointer.active) {
        const dx = px - pointer.x, dy = py - pointer.y, dist = Math.hypot(dx, dy);
        if (dist < 95 && dist > 1) { const f = (95 - dist) / 95 * 18; p.dx += (dx / dist) * f; p.dy += (dy / dist) * f; }
      }
      p.dx *= 0.93; p.dy *= 0.93; px += p.dx; py += p.dy;

      const dWave = Math.abs(t - wx); let pCol = p.color, pSz = p.size;
      if (dWave < 0.07 * L) { const wr = 1 - (dWave / (0.07 * L)); pSz *= (1 + wr * 1.5); pCol = '#fff'; }
      ctx.fillStyle = pCol; ctx.beginPath(); ctx.arc(px, py, pSz, 0, Math.PI * 2); ctx.fill();
    }

    if (wx > 0 && wx < L) {
      const wcl = A * Math.sin((wx / L) * 2.5 * Math.PI - 0.6);
      const hx = isDesktop ? wx : width * 0.35 + wcl, hy = isDesktop ? height * 0.5 + wcl : wx;
      const hg = ctx.createRadialGradient(hx, hy, 0, hx, hy, 44);
      hg.addColorStop(0, 'rgba(255,255,255,0.8)'); hg.addColorStop(0.35, 'rgba(56,189,248,0.45)'); hg.addColorStop(1, 'rgba(56,189,248,0)');
      ctx.fillStyle = hg; ctx.beginPath(); ctx.arc(hx, hy, 44, 0, Math.PI * 2); ctx.fill();
    }

    for (let s = shockwaves.length - 1; s >= 0; s--) {
      const sw = shockwaves[s]; sw.r += 65 * dt; sw.alpha -= 0.95 * dt;
      if (sw.alpha <= 0 || sw.r >= sw.maxR) { shockwaves.splice(s, 1); continue; }
      ctx.strokeStyle = `rgba(94,225,255,${sw.alpha})`; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(sw.x, sw.y, sw.r, 0, Math.PI * 2); ctx.stroke();
    }
    for (let s = sparks.length - 1; s >= 0; s--) {
      const sp = sparks[s]; sp.x += sp.vx * dt; sp.y += sp.vy * dt; sp.life -= 1.6 * dt;
      if (sp.life <= 0) { sparks.splice(s, 1); continue; }
      ctx.fillStyle = sp.color; ctx.globalAlpha = Math.max(0, sp.life); ctx.beginPath(); ctx.arc(sp.x, sp.y, 1.8, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1;
    }
    animId = requestAnimationFrame(tick);
  }

  field.addEventListener('mousemove', (e) => { const r = field.getBoundingClientRect(); pointer.x = e.clientX - r.left; pointer.y = e.clientY - r.top; pointer.active = true; });
  field.addEventListener('mouseleave', () => { pointer.active = false; });
  field.addEventListener('touchmove', (e) => { if (e.touches[0]) { const r = field.getBoundingClientRect(); pointer.x = e.touches[0].clientX - r.left; pointer.y = e.touches[0].clientY - r.top; pointer.active = true; } }, { passive: true });
  field.addEventListener('touchend', () => { pointer.active = false; });

  gates.forEach((g, idx) => { g.addEventListener('click', () => { if (gateCoords[idx]) { wx = gateCoords[idx].t * L + 4; setActiveStage(idx); } }); });

  if (pauseBtn) {
    pauseBtn.addEventListener('click', () => {
      isPaused = !isPaused; container.classList.toggle('flow-paused', isPaused);
      const pauseIcon = pauseBtn.querySelector('.pause-icon'), resumeIcon = pauseBtn.querySelector('.resume-icon'), lbl = pauseBtn.querySelector('.pause-label');
      if (isPaused) {
        if (pauseIcon) pauseIcon.hidden = true; if (resumeIcon) resumeIcon.hidden = false;
        if (lbl) lbl.textContent = labelsData.resume;
        if (pauseBtn) pauseBtn.setAttribute('aria-label', labelsData.resume);
        if (animId) cancelAnimationFrame(animId);
        gates.forEach((g, i) => { g.classList.add('done'); labels[i].classList.add('done'); });
      } else {
        if (pauseIcon) pauseIcon.hidden = false; if (resumeIcon) resumeIcon.hidden = true;
        if (lbl) lbl.textContent = labelsData.pause;
        if (pauseBtn) pauseBtn.setAttribute('aria-label', labelsData.pause);
        lastTime = performance.now(); setActiveStage(currentActive); animId = requestAnimationFrame(tick);
      }
    });
  }

  let rTimer; window.addEventListener('resize', () => { clearTimeout(rTimer); rTimer = setTimeout(updateGatePositions, 150); });
  updateGatePositions();
  if (isPaused) {
    container.classList.add('flow-paused');
    const pauseIcon = pauseBtn?.querySelector('.pause-icon'), resumeIcon = pauseBtn?.querySelector('.resume-icon'), label = pauseBtn?.querySelector('.pause-label');
    if (pauseIcon) pauseIcon.hidden = true;
    if (resumeIcon) resumeIcon.hidden = false;
    if (label) label.textContent = labelsData.resume;
    pauseBtn?.setAttribute('aria-label', labelsData.resume);
  } else {
    animId = requestAnimationFrame(tick);
  }
})();
</script>

<style>
  .stage {
