---
---

<section id="hero" class="pt-32 pb-20 md:pt-40 md:pb-28">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
      
      <!-- Left Column: Bio & Core Actions -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-800 bg-zinc-900/80 text-zinc-300 text-xs font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>Available for Software Engineering Roles</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-bold tracking-tight text-zinc-100 leading-[1.12]">
          Building dependable backend architectures &amp; web apps.
        </h1>

        <p class="text-zinc-400 text-base sm:text-lg max-w-xl leading-relaxed">
          I am Anthony Suryadjie, a software developer focused on RESTful API design, database schema modeling, and production-ready web systems. Pragmatic engineering from database tables to interactive clients.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2 text-sm">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-zinc-100 hover:bg-white text-zinc-950 font-medium transition-all shadow-sm focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:outline-none"
          >
            <span>Explore Systems</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href="https://github.com/ThonyBiersack"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-zinc-800 bg-zinc-900/60 hover:bg-zinc-800/60 hover:border-zinc-700 text-zinc-300 transition-all focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:outline-none"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
            </svg>
            <span>GitHub</span>
          </a>
          <a
            href="mailto:thony.djie@djieproduction.com"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-zinc-800/80 bg-zinc-900/30 hover:bg-zinc-800/50 text-zinc-400 hover:text-zinc-200 transition-all font-mono text-xs"
          >
            <span>thony.djie@djieproduction.com</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Architecture & Core Standards Deck -->
      <div class="lg:col-span-5">
        <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 backdrop-blur-sm p-6 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-zinc-800/80">
            <span class="text-xs font-mono font-medium text-zinc-400 uppercase tracking-wider">Engineering Focus</span>
            <span class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Verified Stack
            </span>
          </div>

          <div class="space-y-4 text-xs">
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded-md bg-zinc-800/80 border border-zinc-700/60 flex items-center justify-center shrink-0 text-zinc-300 font-mono text-[11px]">
                01
              </div>
              <div>
                <h2 class="font-medium text-zinc-200 text-sm">Backend &amp; API Architecture</h2>
                <p class="text-zinc-400 mt-0.5 leading-relaxed">
                  Clean REST contracts, input payload validation with Hapi &amp; Joi, and layered middleware architectures.
                </p>
              </div>
            </div>

            <div class="flex gap-3">
              <div class="w-6 h-6 rounded-md bg-zinc-800/80 border border-zinc-700/60 flex items-center justify-center shrink-0 text-zinc-300 font-mono text-[11px]">
                02
              </div>
              <div>
                <h2 class="font-medium text-zinc-200 text-sm">Data Modeling &amp; Persistence</h2>
                <p class="text-zinc-400 mt-0.5 leading-relaxed">
                  Relational constraints &amp; offline persistence in SQLite; schema modeling and index tuning in MongoDB.
                </p>
              </div>
            </div>

            <div class="flex gap-3">
              <div class="w-6 h-6 rounded-md bg-zinc-800/80 border border-zinc-700/60 flex items-center justify-center shrink-0 text-zinc-300 font-mono text-[11px]">
                03
              </div>
              <div>
                <h2 class="font-medium text-zinc-200 text-sm">Security &amp; Authorization</h2>
                <p class="text-zinc-400 mt-0.5 leading-relaxed">
                  Stateless JWT sessions, password hashing (bcrypt), and granular Role-Based Access Control (RBAC).
                </p>
              </div>
            </div>

            <div class="flex gap-3">
              <div class="w-6 h-6 rounded-md bg-zinc-800/80 border border-zinc-700/60 flex items-center justify-center shrink-0 text-zinc-300 font-mono text-[11px]">
                04
              </div>
              <div>
                <h2 class="font-medium text-zinc-200 text-sm">Client &amp; Systems Delivery</h2>
                <p class="text-zinc-400 mt-0.5 leading-relaxed">
                  Astro zero-JS islands, Tailwind utility ergonomics, and cross-platform Flutter mobile clients.
                </p>
              </div>
            </div>
          </div>

          <!-- Live Endpoint Reference -->
          <div class="pt-3 border-t border-zinc-800/80 flex items-center justify-between text-[11px] font-mono text-zinc-400">
            <span>GET /api/health</span>
            <a
              href="/api/health.json"
              target="_blank"
              class="text-zinc-300 hover:text-white underline underline-offset-2 transition-colors"
            >
              200 OK (view json)
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
