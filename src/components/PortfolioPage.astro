---
import Layout from '../layouts/Layout.astro';
import { content, type Language } from '../data/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = content[lang];
const currentYear = new Date().getFullYear();

const waUrl = lang === 'id'
  ? "https://wa.me/6283845641526?text=Halo%20Anthony,%20saya%20ingin%20konsultasi%20dan%20meminta%20estimasi%20project%20dengan%20Djie%20Production."
  : "https://wa.me/6283845641526?text=Hi%20Anthony,%20I%20would%20like%20to%20request%20a%20quote%20and%20discuss%20a%20project%20with%20Djie%20Production.";
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
>
  <!-- ========================================================
       TOP FLOATING CAPSULE NAVBAR
       ======================================================== -->
  <header class="fixed top-3 sm:top-4 left-0 right-0 z-50 flex justify-center px-3 sm:px-4 pointer-events-none">
    <div class="pointer-events-auto flex items-center justify-between gap-2.5 sm:gap-6 px-3.5 sm:px-6 py-2 rounded-full bg-[#0d1017]/90 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/60 transition-all max-w-[94vw] sm:max-w-none">
      
      <!-- Studio Icon "D" Only -->
      <a href="#hero" class="flex items-center group shrink-0" aria-label="Djie Production Home">
        <img
          src="/djie-icon-white.svg"
          alt="Djie Production"
          class="h-6 w-6 sm:h-7 sm:w-7 object-contain group-hover:scale-105 transition-transform"
          width="28"
          height="28"
        />
      </a>

      <!-- Responsive Navigation Links -->
      <nav class="flex items-center gap-2.5 sm:gap-5 text-[11px] sm:text-xs font-mono text-text-muted" aria-label="Main Navigation">
        <a href="#about" class="hidden sm:inline-block hover:text-white transition-colors">{t.nav.about}</a>
        <a href="#services" class="hover:text-white transition-colors">{t.nav.services}</a>
        <a href="#why-me" class="hidden md:inline-block hover:text-white transition-colors">{t.nav.whyMe}</a>
        <a href="#workflow" class="hover:text-white transition-colors">{t.nav.pipeline}</a>
        <a href="#contact" class="px-2.5 py-1 rounded-full bg-white/[0.08] hover:bg-white/[0.15] text-white transition-colors font-semibold">{t.nav.contact}</a>
      </nav>

      <!-- Language Toggle (EN / ID) -->
      <div class="flex items-center gap-1 text-[11px] font-mono border-l border-white/10 pl-2.5 sm:pl-3">
        <a
          href="/"
          class={`px-1.5 py-0.5 rounded transition-colors ${lang === 'en' ? 'bg-sky-500/20 text-sky-300 font-bold' : 'text-text-muted hover:text-white'}`}
          aria-label="English Version"
        >
          EN
        </a>
        <span class="text-white/20">/</span>
        <a
          href="/id"
          class={`px-1.5 py-0.5 rounded transition-colors ${lang === 'id' ? 'bg-sky-500/20 text-sky-300 font-bold' : 'text-text-muted hover:text-white'}`}
          aria-label="Versi Bahasa Indonesia"
        >
          ID
        </a>
      </div>

    </div>
  </header>

  <main id="main-content" class="pt-20 sm:pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 sm:space-y-24 lg:space-y-28">
      
      <!-- ========================================================
           SECTION 1: HERO
           ======================================================== -->
      <section id="hero" class="pt-12 md:pt-20 pb-4 space-y-12">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          
          <!-- Left Column: Typography & Positioning -->
          <div class="lg:col-span-7 space-y-7 text-left">
            <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-sky-500/30 bg-sky-950/40 text-sky-300 text-xs font-mono shadow-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>{t.hero.roleStatus}</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.08] text-white">
              {t.hero.headlineStart}<span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-blue-400 to-indigo-300">{t.hero.headlineHighlight}</span>{t.hero.headlineEnd}
            </h1>

            <p class="text-text-muted text-base sm:text-lg leading-relaxed max-w-xl" set:html={t.hero.bio} />

            <div class="flex flex-wrap items-center gap-3 pt-1 text-sm font-mono">
              <a
                href="#services"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold transition-all shadow-xl shadow-sky-500/20 active:scale-95 text-xs sm:text-sm"
              >
                <span>{t.hero.exploreBtn}</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>

              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-emerald-500/30 bg-emerald-950/30 hover:bg-emerald-900/40 text-emerald-300 transition-all text-xs font-semibold"
              >
                <span>{t.hero.quoteBtn}</span>
                &rarr;
              </a>

              <a
                href={t.hero.cvUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-white/10 bg-white/[0.04] hover:bg-white/[0.08] text-zinc-200 transition-all text-xs font-semibold"
              >
                <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span>{t.hero.downloadCvBtn}</span>
              </a>
            </div>
          </div>

          <!-- Right Column: System Architecture Console -->
          <div class="lg:col-span-5">
            <div class="terminal-window p-5 space-y-4">
              <!-- Window Bar -->
              <div class="flex items-center justify-between pb-3 border-b border-white/[0.08] text-xs font-mono">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-2 text-text-dim text-[11px]">{t.hero.console.windowTitle}</span>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  {t.hero.console.statusBadge}
                </span>
              </div>

              <!-- Live Architecture Nodes -->
              <div class="space-y-3 font-mono text-xs">
                
                <!-- Node 1: Client Layer -->
                <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between gap-2">
                  <div class="space-y-0.5 min-w-0">
                    <div class="text-[10px] uppercase tracking-wider text-text-dim truncate">{t.hero.console.layer1Title}</div>
                    <div class="text-white font-semibold flex items-center gap-2 text-xs sm:text-sm">
                      <span class="truncate">{t.hero.console.layer1Name}</span>
                    </div>
                  </div>
                  <span class="text-[10px] sm:text-[11px] text-sky-400 bg-sky-950/60 px-2 py-0.5 rounded border border-sky-500/30 shrink-0">{t.hero.console.layer1Tag}</span>
                </div>

                <!-- Pipeline Indicator -->
                <div class="flex items-center justify-center text-text-dim text-[10px] -my-1 text-center">
                  <span>{t.hero.console.gatewayText}</span>
                </div>

                <!-- Node 2: Service & Auth Layer -->
                <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between gap-2">
                  <div class="space-y-0.5 min-w-0">
                    <div class="text-[10px] uppercase tracking-wider text-text-dim truncate">{t.hero.console.layer2Title}</div>
                    <div class="text-white font-semibold flex items-center gap-2 text-xs sm:text-sm">
                      <span class="truncate">{t.hero.console.layer2Name}</span>
                    </div>
                  </div>
                  <span class="text-[10px] sm:text-[11px] text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-500/30 shrink-0">{t.hero.console.layer2Tag}</span>
                </div>

                <!-- Pipeline Indicator -->
                <div class="flex items-center justify-center text-text-dim text-[10px] -my-1 text-center">
                  <span>{t.hero.console.dbText}</span>
                </div>

                <!-- Node 3: Persistence Layer -->
                <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between gap-2">
                  <div class="space-y-0.5 min-w-0">
                    <div class="text-[10px] uppercase tracking-wider text-text-dim truncate">{t.hero.console.layer3Title}</div>
                    <div class="text-white font-semibold flex items-center gap-2 text-xs sm:text-sm">
                      <span class="truncate">{t.hero.console.layer3Name}</span>
                    </div>
                  </div>
                  <span class="text-[10px] sm:text-[11px] text-indigo-300 bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-500/30 shrink-0">{t.hero.console.layer3Tag}</span>
                </div>

              </div>

              <!-- Console Status Footer -->
              <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between text-[11px] font-mono text-text-dim">
                <span>{t.hero.console.footerLeft}</span>
                <span class="text-sky-300">{t.hero.console.footerRight}</span>
              </div>
            </div>
          </div>

        </div>

        <!-- ========================================================
             FACTUAL ARCHITECTURE & QUALITY STRIP (NO EXAGGERATIONS)
             ======================================================== -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 p-3.5 sm:p-5 rounded-2xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-md font-mono text-xs">
          <div class="space-y-1 p-1.5 sm:p-2">
            <div class="text-lg sm:text-xl font-black text-white">{t.metrics.item1.val}</div>
            <div class="text-sky-300 font-semibold text-[10px] sm:text-[11px]">{t.metrics.item1.title}</div>
            <div class="text-text-dim text-[9px] sm:text-[10px] leading-tight">{t.metrics.item1.sub}</div>
          </div>
          <div class="space-y-1 p-1.5 sm:p-2">
            <div class="text-lg sm:text-xl font-black text-white">{t.metrics.item2.val}</div>
            <div class="text-emerald-300 font-semibold text-[10px] sm:text-[11px]">{t.metrics.item2.title}</div>
            <div class="text-text-dim text-[9px] sm:text-[10px] leading-tight">{t.metrics.item2.sub}</div>
          </div>
          <div class="space-y-1 p-1.5 sm:p-2">
            <div class="text-lg sm:text-xl font-black text-white">{t.metrics.item3.val}</div>
            <div class="text-white font-semibold text-[10px] sm:text-[11px]">{t.metrics.item3.title}</div>
            <div class="text-text-dim text-[9px] sm:text-[10px] leading-tight">{t.metrics.item3.sub}</div>
          </div>
          <div class="space-y-1 p-1.5 sm:p-2">
            <div class="text-lg sm:text-xl font-black text-white">{t.metrics.item4.val}</div>
            <div class="text-indigo-300 font-semibold text-[10px] sm:text-[11px]">{t.metrics.item4.title}</div>
            <div class="text-text-dim text-[9px] sm:text-[10px] leading-tight">{t.metrics.item4.sub}</div>
          </div>
        </div>

      </section>

      <!-- ========================================================
           SECTION 2: ABOUT (INDEPENDENT DEVELOPER MODEL)
           ======================================================== -->
      <section id="about" class="scroll-reveal space-y-10 pt-10 border-t border-white/[0.07]">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          
          <!-- Narrative -->
          <div class="lg:col-span-7 space-y-5">
            <p class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold">{t.about.tag}</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
              {t.about.title}
            </h2>

            <div class="space-y-4 text-text-muted text-sm sm:text-base leading-relaxed">
              {t.about.paragraphs.map((p) => (
                <p set:html={p} />
              ))}
            </div>

            <!-- Key Advantages Pill -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs font-mono">
              {t.about.advantages.map((adv) => (
                <div class="p-4 rounded-xl bg-black/40 border border-white/[0.08]">
                  <div class="text-white font-semibold mb-1">{adv.title}</div>
                  <div class="text-text-dim leading-relaxed">{adv.desc}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Studio Dossier Card -->
          <div class="lg:col-span-5">
            <div class="rounded-2xl border border-white/10 bg-[#0d1017] p-5 sm:p-7 space-y-6 shadow-xl">
              <div class="pb-4 border-b border-white/[0.08] flex items-center justify-between">
                <div>
                  <h3 class="text-base font-bold text-white">{t.about.dossier.title}</h3>
                  <p class="text-xs font-mono text-text-dim">{t.about.dossier.subtitle}</p>
                </div>
                <img src="/djie-icon-white.svg" alt="Djie Icon" class="w-8 h-8 opacity-80" />
              </div>

              <div class="space-y-3 font-mono text-xs">
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">{t.about.dossier.operatingModelLabel}</span>
                  <span class="text-white">{t.about.dossier.operatingModelVal}</span>
                </div>
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">{t.about.dossier.founderLabel}</span>
                  <span class="text-sky-300 font-medium">{t.about.dossier.founderVal}</span>
                </div>
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">{t.about.dossier.locationLabel}</span>
                  <span class="text-white">{t.about.dossier.locationVal}</span>
                </div>
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">{t.about.dossier.whatsappLabel}</span>
                  <a href="https://wa.me/6283845641526" target="_blank" class="text-emerald-400 hover:underline">+62 838-4564-1526</a>
                </div>
                <div class="flex justify-between py-1.5 border-b border-white/[0.04]">
                  <span class="text-text-dim">{t.about.dossier.emailLabel}</span>
                  <span class="text-sky-300">thony.djie@djieproduction.com</span>
                </div>
                <div class="flex justify-between pt-2">
                  <span class="text-text-dim">{t.about.dossier.availabilityLabel}</span>
                  <span class="text-emerald-400 flex items-center gap-1.5 text-right">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
                    <span>{t.about.dossier.availabilityVal}</span>
                  </span>
                </div>
              </div>

              <div class="pt-4 border-t border-white/[0.08]">
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 font-mono text-xs font-medium flex items-center justify-center gap-2 border border-emerald-500/30 transition-colors"
                >
                  <span>{t.about.dossier.ctaText}</span>
                  &rarr;
                </a>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ========================================================
           SECTION 3: SERVICES & HANDLED PROJECTS (BENTO GRID)
           ======================================================== -->
      <section id="services" class="scroll-reveal space-y-8 pt-10 border-t border-white/[0.07]">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold mb-2">{t.services.tag}</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t.services.title}</h2>
            <p class="text-text-muted text-sm sm:text-base mt-2 max-w-2xl">
              {t.services.subtitle}
            </p>
          </div>
          <div class="hidden md:flex items-center gap-2 font-mono text-xs text-text-dim">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>{t.services.badgeCount}</span>
          </div>
        </div>

        <!-- Consultation & Scope Pricing Note (Requirement 6) -->
        <div class="p-4 rounded-xl bg-sky-950/30 border border-sky-500/20 text-sky-200 text-xs sm:text-sm flex items-center gap-3">
          <svg class="w-5 h-5 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="leading-relaxed">{t.services.pricingNote}</span>
        </div>

        <div class="grid grid-cols-12 gap-6">
          {t.services.projects.map((item, idx) => {
            const colSpan = (idx === 0 || idx === 3) 
              ? "col-span-12 lg:col-span-7" 
              : "col-span-12 lg:col-span-5";

            return (
              <article class={`${colSpan} bento-card p-5 sm:p-7 md:p-8 flex flex-col justify-between group transition-all duration-300`}>
                <div class="space-y-6">
                  
                  <!-- Service Category Header -->
                  <div class="border-b border-white/[0.08] pb-4">
                    <div class="flex items-center justify-between text-xs font-mono mb-2">
                      <span class="text-sky-400 font-semibold tracking-wider">CAPABILITY 0{idx + 1}</span>
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 font-mono">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        {item.status}
                      </span>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-sky-300 transition-colors">
                      {item.serviceCategory}
                    </h3>
                    <p class="text-text-muted text-xs leading-relaxed mt-1">
                      {item.serviceSubtitle}
                    </p>
                  </div>

                  <!-- Associated Project Handled Details -->
                  <div class="space-y-4">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-mono text-text-dim uppercase tracking-wider">Handled Platform</span>
                      <span class="px-2.5 py-0.5 rounded text-[11px] font-mono bg-white/[0.04] border border-white/10 text-slate-300">
                        {item.projectBadge}
                      </span>
                    </div>

                    <h4 class="text-lg font-bold text-slate-100">
                      {item.projectTitle}
                    </h4>

                    <p class="text-xs text-text-muted leading-relaxed">
                      {item.description}
                    </p>

                    <!-- Highlights / What was architected -->
                    <div class="space-y-2.5 pt-1 rounded-xl bg-black/30 p-4 border border-white/[0.04]">
                      <div class="text-[11px] font-mono text-sky-300 uppercase tracking-wider">{t.services.highlightsTitle}</div>
                      <ul class="space-y-2 text-xs text-text-muted">
                        {item.highlights.map((point) => (
                          <li class="flex items-start gap-2">
                            <span class="text-sky-400 font-bold shrink-0 mt-0.5">&bull;</span>
                            <span class="leading-relaxed">{point}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- Tech Stack Pills -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {item.tech.map((techItem) => (
                        <span class="px-2.5 py-1 rounded text-xs font-mono bg-black/50 border border-white/[0.08] text-slate-300">
                          {techItem}
                        </span>
                      ))}
                    </div>
                  </div>

                </div>

                <!-- Project Links / Verification -->
                <div class="pt-6 border-t border-white/[0.08] mt-6 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
                  <div class="flex flex-wrap items-center gap-3">
                    {item.demoUrl ? (
                      <a
                        href={item.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-md bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold transition-all shadow-md shadow-sky-500/20"
                      >
                        <span>Live Production</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                      </a>
                    ) : item.isComingSoonDemo ? (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white/[0.05] border border-white/10 text-zinc-400 text-xs font-mono cursor-default select-none">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400/80"></span>
                        <span>{lang === 'id' ? 'Demo segera hadir' : 'Demo coming soon'}</span>
                      </span>
                    ) : null}

                    {item.repoUrl && (
                      <a
                        href={item.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-text-muted hover:text-white transition-colors"
                      >
                        <span>Source Code</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                        </svg>
                      </a>
                    )}
                  </div>
                  <span class="text-text-dim text-[11px]">Djie Production</span>
                </div>
              </article>
            );
