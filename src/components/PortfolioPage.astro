---
import Layout from '../layouts/Layout.astro';
import HeroSection from './sections/HeroSection.astro';
import AboutSection from './sections/AboutSection.astro';
import ServiceCategoriesSection from './sections/ServiceCategoriesSection.astro';
import ProjectsSection from './sections/ProjectsSection.astro';
import TestimonialsSection from './sections/TestimonialsSection.astro';
import WhyMeSection from './sections/WhyMeSection.astro';
import WorkflowSection from './sections/WorkflowSection.astro';
import ContactSection from './sections/ContactSection.astro';
import FooterSection from './sections/FooterSection.astro';
import { content, type Language } from '../data/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = content[lang];

const waUrl = lang === 'id'
  ? "https://wa.me/6283845641526?text=Halo%20Anthony,%20saya%20ingin%20konsultasi%20dan%20meminta%20estimasi%20project%20dengan%20Djie%20Production."
  : "https://wa.me/6283845641526?text=Hi%20Anthony,%20I%20would%20like%20to%20request%20a%20quote%20and%20discuss%20a%20project%20with%20Djie%20Production.";
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
>
  <!-- TOP FLOATING CAPSULE NAVBAR -->
  <header class="fixed top-3 sm:top-4 left-0 right-0 z-50 flex justify-center px-3 sm:px-4 pointer-events-none">
    <div class="pointer-events-auto flex items-center justify-between gap-2.5 sm:gap-6 px-3.5 sm:px-6 py-2 rounded-full bg-[#0d1017]/90 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/60 transition-all max-w-[94vw] sm:max-w-none">
      
      <!-- Studio Icon "D" Only -->
      <a href="#hero" class="flex items-center group shrink-0" aria-label="Djie Production Home">
        <img
          src="/djie-icon-white.svg"
          alt="Djie Production"
          class="h-6 w-6 sm:h-7 sm:w-7 object-contain group-hover:scale-105 transition-transform"
          width="28"
          height="28"
        />
      </a>

      <!-- Responsive Navigation Links -->
      <nav class="flex items-center gap-2.5 sm:gap-5 text-[11px] sm:text-xs font-mono text-text-muted" aria-label="Main Navigation">
        <a href="#about" class="hidden sm:inline-block hover:text-white transition-colors">{t.nav.about}</a>
        <a href="#services-overview" class="hover:text-white transition-colors">{t.nav.services}</a>
        <a href="#why-me" class="hidden md:inline-block hover:text-white transition-colors">{t.nav.whyMe}</a>
        <a href="#workflow" class="hover:text-white transition-colors">{t.nav.pipeline}</a>
        <a href="#contact" class="px-2.5 py-1 rounded-full bg-white/[0.08] hover:bg-white/[0.15] text-white transition-colors font-semibold">{t.nav.contact}</a>
      </nav>

      <!-- Language Toggle (ID / EN - ID as Default) -->
      <div class="flex items-center gap-1 text-[11px] font-mono border-l border-white/10 pl-2.5 sm:pl-3">
        <a
          href="/"
          class={`px-1.5 py-0.5 rounded transition-colors ${lang === 'id' ? 'bg-sky-500/20 text-sky-300 font-bold' : 'text-text-muted hover:text-white'}`}
          aria-label="Versi Bahasa Indonesia (Default)"
        >
          ID
        </a>
        <span class="text-white/20">/</span>
        <a
          href="/en"
          class={`px-1.5 py-0.5 rounded transition-colors ${lang === 'en' ? 'bg-sky-500/20 text-sky-300 font-bold' : 'text-text-muted hover:text-white'}`}
          aria-label="English Version"
        >
          EN
        </a>
      </div>

    </div>
  </header>

  <main id="main-content" class="pt-20 sm:pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 sm:space-y-24 lg:space-y-28">
      <HeroSection t={t} lang={lang} waUrl={waUrl} />
      <AboutSection t={t} lang={lang} waUrl={waUrl} />
      <ServiceCategoriesSection t={t} lang={lang} />
      <ProjectsSection t={t} lang={lang} />
      <TestimonialsSection t={t} lang={lang} />
      <WhyMeSection t={t} lang={lang} />
      <WorkflowSection t={t} lang={lang} />
      <ContactSection t={t} lang={lang} waUrl={waUrl} />
    </div>
  </main>

  <FooterSection t={t} lang={lang} />

  <!-- Floating WhatsApp Quick Action Button -->
  <aside class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-40 pointer-events-auto" aria-label="WhatsApp Quick Contact">
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2.5 px-3.5 py-2.5 sm:px-4 sm:py-3 rounded-full bg-[#128C7E] hover:bg-[#075E54] text-white shadow-2xl shadow-emerald-950/80 border border-emerald-400/30 transition-all duration-300 hover:scale-105 group active:scale-95"
      aria-label={lang === 'id' ? 'Konsultasi langsung via WhatsApp dengan Djie Production' : 'Chat directly via WhatsApp with Djie Production'}
    >
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-200"></span>
      </span>
      <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.42-.101.825zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.954-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
      </svg>
      <span class="text-xs font-semibold font-mono tracking-tight hidden sm:inline-block">
        Chat WhatsApp
      </span>
    </a>
  </aside>

  <!-- Client-side Interactions -->
  <script>
    // 1. Email Clipboard Helper
    const setupEmailCopy = (btnId: string) => {
      const btn = document.getElementById(btnId);
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('thony.djie@djieproduction.com');
          const original = btn.textContent;
          btn.textContent = '(Copied!)';
          setTimeout(() => {
            btn.textContent = original;
          }, 2000);
        } catch (e) {
          console.error(e);
        }
      });
    };

    setupEmailCopy('contact-copy-email');

    // 2. Linear-Style Mouse Spotlight on Bento Cards
    const bentoCards = document.querySelectorAll<HTMLElement>('.bento-card');
    bentoCards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });

    // 3. Fast Snappy Scroll-Reveal (Hardware-Accelerated)
    const revealElements = document.querySelectorAll('.scroll-reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );

      revealElements.forEach((el) => observer.observe(el));
    } else {
      revealElements.forEach((el) => el.classList.add('is-revealed'));
    }
  </script>
</Layout>
