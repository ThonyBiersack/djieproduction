---
const skillDomains = [
  {
    domain: "Backend Engineering",
    description: "Server architecture, API design, and asynchronous runtimes.",
    skills: ["Node.js", "Express.js", "Hapi.js", "RESTful Contracts", "Input Validation (Joi)", "CRUD Workflows"]
  },
  {
    domain: "Data & Storage",
    description: "Database schemas, relation modeling, and local persistence.",
    skills: ["MongoDB", "Mongoose ODM", "SQLite", "Data Normalization", "Indexing Strategies", "Local Offline Sync"]
  },
  {
    domain: "Security & Auth",
    description: "Application-level security and authentication pipelines.",
    skills: ["JWT Authentication", "RBAC Middleware", "Bcrypt Hashing", "Bearer Tokens", "Session Hardening"]
  },
  {
    domain: "Client & UI Platforms",
    description: "Clean component models, static islands, and mobile interfaces.",
    skills: ["Astro", "Tailwind CSS", "TypeScript", "JavaScript (ES6+)", "Flutter & Dart", "Responsive Design"]
  },
  {
    domain: "Workflow & Tooling",
    description: "Developer ergonomics, version control, and cloud platforms.",
    skills: ["Git & GitHub", "Render PaaS", "Postman", "Vite", "VS Code", "Terminal Workflows"]
  }
];
---

<section id="skills" class="py-24 border-t border-zinc-800/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="mb-12">
      <p class="text-xs font-mono uppercase tracking-widest text-zinc-400 mb-2 font-medium">Stack &amp; Skills</p>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100">Technical Competencies</h2>
      <p class="text-zinc-400 text-sm mt-2 max-w-xl">
        Technologies and paradigms I use to design, build, and deploy production software.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillDomains.map((item) => (
        <div class="scroll-reveal rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-6 flex flex-col justify-between hover:border-zinc-700 transition-colors">
          <div>
            <h3 class="text-base font-semibold text-zinc-100 tracking-tight">
              {item.domain}
            </h3>
            <p class="text-xs text-zinc-400 mt-1 mb-5 leading-relaxed">
              {item.description}
            </p>

            <div class="flex flex-wrap gap-1.5">
              {item.skills.map((skill) => (
                <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-zinc-800/50 border border-zinc-700/40 text-zinc-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
