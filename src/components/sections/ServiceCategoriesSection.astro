---
import type { SiteContent, Language } from '../../data/translations';

interface Props {
  t: SiteContent;
  lang: Language;
}

const { t } = Astro.props;
---

<section id="services-overview" class="scroll-reveal scroll-mt-24 space-y-8 pt-10 border-t border-white/[0.07]">
  <div class="space-y-2">
    <p class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold">{t.serviceCategories.tag}</p>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t.serviceCategories.title}</h2>
    <p class="text-text-muted text-sm sm:text-base max-w-2xl leading-relaxed">
      {t.serviceCategories.subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {t.serviceCategories.items.map((svc) => (
      <div class="bento-card p-6 sm:p-7 flex flex-col justify-between group transition-all duration-300">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 group-hover:scale-105 group-hover:bg-sky-500/20 transition-all">
            {svc.icon === 'globe' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
            )}
            {svc.icon === 'smartphone' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
                <line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2.5" />
              </svg>
            )}
            {svc.icon === 'server' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                <line x1="6" y1="6" x2="6.01" y2="6" stroke-width="2.5" />
                <line x1="6" y1="18" x2="6.01" y2="18" stroke-width="2.5" />
              </svg>
            )}
            {svc.icon === 'mail' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
              </svg>
            )}
          </div>

          <div>
            <h3 class="text-xl font-bold text-white group-hover:text-sky-300 transition-colors">
              {svc.title}
            </h3>
            <p class="text-text-muted text-sm leading-relaxed mt-2">
              {svc.description}
            </p>
          </div>
        </div>

        <div class="pt-5 mt-5 border-t border-white/[0.08] flex flex-wrap gap-2">
          {svc.stack.map((item) => (
            <span class="px-2.5 py-1 rounded text-xs font-mono bg-white/[0.03] border border-white/[0.08] text-zinc-300">
              {item}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

