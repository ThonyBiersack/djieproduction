---
import type { SiteContent, Language } from '../../data/translations';
import PipelineCats from '../PipelineCats.astro';

interface Props {
  t: SiteContent;
  lang: Language;
}

const { t } = Astro.props;
---

<section id="workflow" class="scroll-reveal scroll-mt-24 space-y-10 pt-10 border-t border-white/[0.07]">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold mb-2">{t.workflow.tag}</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t.workflow.title}</h2>
      <p class="text-text-muted text-sm sm:text-base mt-2 max-w-2xl">
        {t.workflow.subtitle}
      </p>
    </div>
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-sky-950/40 border border-sky-500/20 text-sky-300 font-mono text-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{t.workflow.badge}</span>
    </div>
  </div>

  <!-- Animated Cat Crew Delivery Pipeline -->
  <PipelineCats stages={t.workflow.stages} labels={t.workflow.labels} />
</section>

