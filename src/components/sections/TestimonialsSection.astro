---
import type { SiteContent, Language } from '../../data/translations';

interface Props {
  t: SiteContent;
  lang: Language;
}

const { t } = Astro.props;
---

<section id="testimonials" class="scroll-reveal scroll-mt-24 space-y-8 pt-10 border-t border-white/[0.07]">
  <div class="space-y-2">
    <p class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold">{t.testimonials.tag}</p>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t.testimonials.title}</h2>
    <p class="text-text-muted text-sm sm:text-base max-w-2xl leading-relaxed">
      {t.testimonials.subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {t.testimonials.items.map((item) => (
      <div class="glass-panel rounded-2xl p-6 sm:p-8 flex flex-col justify-between hover:border-sky-500/40 transition-all space-y-6">
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-sky-500/10 border border-sky-500/20 text-sky-300 text-xs font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
              {item.role}
            </span>
          </div>
          <h3 class="text-lg font-bold text-white tracking-tight">{item.name}</h3>
          <p class="text-zinc-300 text-sm sm:text-base leading-relaxed">
            {item.quote}
          </p>
        </div>

        <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-text-dim">
          <span class="text-emerald-400/90 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Verified Deployment
          </span>
          <span class="text-zinc-500">Djie Production</span>
        </div>
      </div>
    ))}
  </div>
</section>

