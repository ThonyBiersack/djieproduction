---
import type { SiteContent, Language } from '../../data/translations';

interface Props {
  t: SiteContent;
  lang: Language;
}

const { t } = Astro.props;
---

<section id="testimonials" class="scroll-reveal scroll-mt-24 space-y-8 pt-10 border-t border-white/[0.07]">
  <div class="space-y-2">
    <p class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold">{t.testimonials.tag}</p>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{t.testimonials.title}</h2>
    <p class="text-text-muted text-sm sm:text-base max-w-2xl leading-relaxed">
      {t.testimonials.subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {t.testimonials.items.map((item) => (
      <div class="glass-panel rounded-2xl p-6 sm:p-8 flex flex-col justify-between hover:border-sky-500/40 transition-all space-y-6">
        <div class="space-y-4">
          <svg class="w-8 h-8 text-sky-400/50" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-zinc-200 text-sm sm:text-base leading-relaxed italic">
            "{item.quote}"
          </p>
        </div>

        <div class="pt-4 border-t border-white/[0.08] flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-sky-500/10 border border-sky-500/20 flex items-center justify-center font-bold font-mono text-sky-300 text-xs">
            {item.name.charAt(0)}
          </div>
          <div>
            <div class="text-white font-semibold text-sm">{item.name}</div>
            <div class="text-text-dim text-xs font-mono">{item.role}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

