---
import type { SiteContent, Language } from '../../data/translations';

interface Props {
  t: SiteContent;
  lang: Language;
  waUrl: string;
}

const { t, lang, waUrl } = Astro.props;
---

<section id="hero" class="pt-12 md:pt-20 pb-4 space-y-12">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    
    <!-- Left Column: Typography & Positioning -->
    <div class="lg:col-span-7 space-y-7 text-left">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-sky-500/30 bg-sky-950/40 text-sky-300 text-xs font-mono shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>{t.hero.roleStatus}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.08] text-white">
        {t.hero.headlineStart}<span class="text-sky-300">{t.hero.headlineHighlight}</span>{t.hero.headlineEnd}
      </h1>

      <p class="text-text-muted text-base sm:text-lg leading-relaxed max-w-xl" set:html={t.hero.bio} />

      <div class="flex flex-wrap items-center gap-3 pt-1 text-sm font-mono">
        <a
          href="#services"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-white/15 bg-white/[0.04] hover:bg-white/[0.08] text-white font-semibold transition-colors text-xs sm:text-sm"
        >
          <span>{t.hero.exploreBtn}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold transition-all shadow-xl shadow-sky-500/20 active:scale-95 text-xs sm:text-sm"
        >
          <span>{t.hero.quoteBtn}</span>
          &rarr;
        </a>
      </div>
    </div>

    <!-- Right Column: System Architecture Console -->
    <div class="lg:col-span-5">
      <div class="terminal-window p-5 space-y-4">
        <!-- Window Bar -->
        <div class="flex items-center justify-between pb-3 border-b border-white/[0.08] text-xs font-mono">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            <span class="ml-2 text-text-dim text-[11px]">{t.hero.console.windowTitle}</span>
          </div>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            {t.hero.console.statusBadge}
          </span>
        </div>

        <!-- Live Architecture Nodes -->
        <div class="space-y-3 font-mono text-xs">
          
          <!-- Node 1: Client Layer -->
          <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between gap-2">
            <div class="space-y-0.5 min-w-0">
              <div class="text-[10px] uppercase tracking-wider text-text-dim truncate">{t.hero.console.layer1Title}</div>
              <div class="text-white font-semibold flex items-center gap-2 text-xs sm:text-sm">
                <span class="truncate">{t.hero.console.layer1Name}</span>
              </div>
            </div>
            <span class="text-[10px] sm:text-[11px] text-sky-400 bg-sky-950/60 px-2 py-0.5 rounded border border-sky-500/30 shrink-0">{t.hero.console.layer1Tag}</span>
          </div>

          <!-- Pipeline Indicator -->
          <div class="flex items-center justify-center text-text-dim text-[10px] -my-1 text-center">
            <span>{t.hero.console.gatewayText}</span>
          </div>

          <!-- Node 2: Service & Auth Layer -->
          <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between gap-2">
            <div class="space-y-0.5 min-w-0">
              <div class="text-[10px] uppercase tracking-wider text-text-dim truncate">{t.hero.console.layer2Title}</div>
              <div class="text-white font-semibold flex items-center gap-2 text-xs sm:text-sm">
                <span class="truncate">{t.hero.console.layer2Name}</span>
              </div>
            </div>
            <span class="text-[10px] sm:text-[11px] text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-500/30 shrink-0">{t.hero.console.layer2Tag}</span>
          </div>

          <!-- Pipeline Indicator -->
          <div class="flex items-center justify-center text-text-dim text-[10px] -my-1 text-center">
            <span>{t.hero.console.dbText}</span>
          </div>

          <!-- Node 3: Persistence Layer -->
          <div class="p-3 rounded-lg bg-black/40 border border-white/[0.06] flex items-center justify-between gap-2">
            <div class="space-y-0.5 min-w-0">
              <div class="text-[10px] uppercase tracking-wider text-text-dim truncate">{t.hero.console.layer3Title}</div>
              <div class="text-white font-semibold flex items-center gap-2 text-xs sm:text-sm">
                <span class="truncate">{t.hero.console.layer3Name}</span>
              </div>
            </div>
            <span class="text-[10px] sm:text-[11px] text-indigo-300 bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-500/30 shrink-0">{t.hero.console.layer3Tag}</span>
          </div>

        </div>

        <!-- Console Status Footer -->
        <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between text-[11px] font-mono text-text-dim">
          <span>{t.hero.console.footerLeft}</span>
          <span class="text-sky-300">{t.hero.console.footerRight}</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Factual Architecture & Track Record Strip -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 p-3.5 sm:p-5 rounded-2xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-md font-mono text-xs">
    <div class="space-y-1 p-1.5 sm:p-2">
      <div class="text-lg sm:text-xl font-black text-white">{t.metrics.item1.val}</div>
      <div class="text-sky-300 font-semibold text-[10px] sm:text-[11px]">{t.metrics.item1.title}</div>
      <div class="text-text-dim text-[9px] sm:text-[10px] leading-tight">{t.metrics.item1.sub}</div>
    </div>
    <div class="space-y-1 p-1.5 sm:p-2">
      <div class="text-lg sm:text-xl font-black text-white">{t.metrics.item2.val}</div>
      <div class="text-emerald-300 font-semibold text-[10px] sm:text-[11px]">{t.metrics.item2.title}</div>
      <div class="text-text-dim text-[9px] sm:text-[10px] leading-tight">{t.metrics.item2.sub}</div>
    </div>
    <div class="space-y-1 p-1.5 sm:p-2">
      <div class="text-lg sm:text-xl font-black text-white">{t.metrics.item3.val}</div>
      <div class="text-white font-semibold text-[10px] sm:text-[11px]">{t.metrics.item3.title}</div>
      <div class="text-text-dim text-[9px] sm:text-[10px] leading-tight">{t.metrics.item3.sub}</div>
    </div>
    <div class="space-y-1 p-1.5 sm:p-2">
      <div class="text-lg sm:text-xl font-black text-white">{t.metrics.item4.val}</div>
      <div class="text-indigo-300 font-semibold text-[10px] sm:text-[11px]">{t.metrics.item4.title}</div>
      <div class="text-text-dim text-[9px] sm:text-[10px] leading-tight">{t.metrics.item4.sub}</div>
    </div>
  </div>
</section>

