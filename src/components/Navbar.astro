---
const navLinks = [
  { name: 'Overview', href: '#hero' },
  { name: 'Projects', href: '#projects' },
  { name: 'Stack', href: '#skills' },
  { name: 'About', href: '#about' },
  { name: 'Contact', href: '#contact' },
];
---

<header class="fixed top-0 left-0 w-full z-50 backdrop-blur-xl bg-zinc-950/70 border-b border-zinc-800/60 transition-all duration-300">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href="#hero" class="flex items-center gap-2.5 group">
      <span class="w-7 h-7 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center font-mono text-xs font-semibold text-zinc-100 group-hover:border-zinc-700 transition-colors">
        AS
      </span>
      <span class="font-medium text-sm text-zinc-100 tracking-tight">Anthony Suryadjie</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-xs" aria-label="Desktop Navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-zinc-400 hover:text-zinc-100 focus-visible:text-zinc-100 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400 rounded px-1 transition-colors duration-150"
        >
          {link.name}
        </a>
      ))}
      <a
        href="mailto:thony.djie@djieproduction.com"
        class="ml-2 px-3.5 py-1.5 rounded-md bg-zinc-100 hover:bg-white text-zinc-950 font-medium text-xs tracking-tight transition-all shadow-sm focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:outline-none"
      >
        Get in touch
      </a>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="menu-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      class="md:hidden flex flex-col justify-center items-center w-8 h-8 rounded-md border border-zinc-800 text-zinc-400 hover:text-zinc-100 focus:outline-none"
    >
      <span class="w-4 h-[1.5px] bg-current transition-all mb-1"></span>
      <span class="w-4 h-[1.5px] bg-current transition-all"></span>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-zinc-800 bg-zinc-950/95 px-6 py-5 space-y-3 text-sm backdrop-blur-xl">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block text-zinc-400 hover:text-zinc-100 transition-colors py-1 mobile-link"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-3 border-t border-zinc-800/80">
      <a
        href="mailto:thony.djie@djieproduction.com"
        class="inline-block w-full text-center px-4 py-2 rounded-md bg-zinc-100 text-zinc-950 font-medium text-xs tracking-tight"
      >
        Get in touch
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = mobileMenu?.classList.toggle('hidden') === false;
    toggleBtn.setAttribute('aria-expanded', String(isExpanded));
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
